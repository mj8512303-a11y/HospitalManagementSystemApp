<!-- Toast -->
<div id="ph-toast"></div>


@section Scripts {
    <script>
/* ═══════════════════════════════════
   TAB SWITCHING
═══════════════════════════════════ */
var _labLoaded = false;
function gotoTab(name) {
    document.querySelectorAll('.ph-nav-item').forEach(function(x){ x.classList.remove('active'); });
    document.querySelectorAll('.ph-pane').forEach(function(x){ x.classList.remove('active'); });
    document.getElementById('nav-' + name).classList.add('active');
    document.getElementById('pane-' + name).classList.add('active');
    if (name === 'lab' && !_labLoaded) { loadLabs(); _labLoaded = true; }
}

/* ═══════════════════════════════════
   TOAST
═══════════════════════════════════ */
function toast(msg, type) {
    var el = document.getElementById('ph-toast');
    el.style.background = type === 'success' ? '#27ae60' : '#e74c3c';
    el.innerHTML = '<i class="fa fa-' + (type==='success'?'check-circle':'times-circle') + '"></i> ' + msg;
    el.style.display = 'flex';
    setTimeout(function(){ el.style.display='none'; }, 3800);
}

function showErr(id, msg) {
    var el = document.getElementById(id);
    el.innerHTML = '<i class="fa fa-exclamation-circle"></i> ' + msg;
    el.style.display = 'flex';
    setTimeout(function(){ el.style.display='none'; }, 5000);
}

/* ═══════════════════════════════════
   QUICK ACTION HELPERS
═══════════════════════════════════ */
function filterLowStock() {
    // show low stock by searching and letting table show all (no direct filter, just navigate)
    loadMedicines();
}
function filterExpiring() {
    loadMedicines();
}

/* ═══════════════════════════════════
   MEDICINE — LOAD TABLE
═══════════════════════════════════ */
function loadMedicines() {
    $('#medBody').html('<tr><td colspan="10" class="empty-state"><i class="fa fa-spinner fa-spin"></i><p>Loading...</p></td></tr>');
    $.getJSON('@Url.Action("GetMedicines","Pharmacy")', {
        search:   $('#medSearch').val(),
        category: $('#medCatFilter').val(),
        branchId: $('#medBranchFilter').val()
    }, function(data) {
        if (!data.length) {
            $('#medBody').html('<tr><td colspan="10" class="empty-state"><i class="fa fa-medkit"></i><p>No medicines found.</p></td></tr>');
            return;
        }
        var html = '';
        $.each(data, function(i, m) {
            var stockCell = m.IsLowStock
                ? '<span class="bdg bdg-lowstock"><i class="fa fa-warning"></i> ' + m.StockQuantity + ' LOW</span>'
                : '<strong style="color:#1e8449">' + m.StockQuantity + '</strong>';
            var expCell = m.IsExpired
                ? '<span class="bdg bdg-expired"><i class="fa fa-times"></i> ' + m.ExpiryDate + '</span>'
                : m.IsExpiringSoon
                    ? '<span class="bdg bdg-expiring"><i class="fa fa-clock-o"></i> ' + m.ExpiryDate + '</span>'
                    : '<span style="color:#5d6d7e">' + m.ExpiryDate + '</span>';
            var stCell = m.IsActive
                ? '<span class="bdg bdg-active"><i class="fa fa-circle" style="font-size:8px"></i> Active</span>'
                : '<span class="bdg bdg-inactive"><i class="fa fa-circle" style="font-size:8px"></i> Inactive</span>';
            var nm = m.Name.replace(/\\/g,'\\\\').replace(/'/g,"\\'");
            html += '<tr>' +
                '<td class="t-muted">'+(i+1)+'</td>'+
                '<td class="t-name">'+m.Name+'</td>'+
                '<td><span class="bdg-cat">'+(m.Category||'-')+'</span></td>'+
                '<td style="color:#5d6d7e">'+(m.Manufacturer||'-')+'</td>'+
                '<td style="color:#5d6d7e">'+m.BranchName+'</td>'+
                '<td>'+stockCell+'</td>'+
                '<td style="font-weight:700;color:#1a2e44">Rs. '+parseFloat(m.UnitPrice).toLocaleString()+'</td>'+
                '<td>'+expCell+'</td>'+
                '<td>'+stCell+'</td>'+
                '<td style="text-align:center">'+
                    '<button class="act-btn ab-view"   title="View"   onclick="openMedDetail('+m.Id+')"><i class="fa fa-eye"></i></button>'+
                    '<button class="act-btn ab-edit"   title="Edit"   onclick="openMedForm('+m.Id+')"><i class="fa fa-pencil"></i></button>'+
                    '<button class="act-btn ab-delete" title="Delete" onclick="askDelete('+m.Id+',\'medicine\',\''+nm+'\')"><i class="fa fa-trash"></i></button>'+
                '</td></tr>';
        });
        $('#medBody').html(html);
    });
}

function resetMed() {
    $('#medSearch,#medCatFilter').val('');
    $('#medBranchFilter').val('0');
    loadMedicines();
}

/* ═══════════════════════════════════
   MEDICINE — ADD/EDIT MODAL
═══════════════════════════════════ */
function openMedForm(id) {
    $('#medFormAlert').hide();
    if (id === 0) {
        $('#medId').val('0');
        $('#medFormTitle').text('Add New Medicine');
        $('#medSaveLbl').text('Save Medicine');
        $('#medName,#medManuf').val('');
        $('#medCat').val('Other');
        $('#medBranchSel').val('0');
        $('#medStock').val('0');
        $('#medPrice').val('0');
        $('#medMinAlert').val('10');
        $('#medExpiry').val('');
        $('#medIsActive').prop('checked', true);
        $('#medFormModal').modal('show');
    } else {
        $.getJSON('@Url.Action("GetMedicine","Pharmacy")', { id: id }, function(d) {
            if (!d.success) { toast('Error loading medicine data','error'); return; }
            $('#medId').val(d.Id);
            $('#medFormTitle').text('Edit — ' + d.Name);
            $('#medSaveLbl').text('Update Medicine');
            $('#medName').val(d.Name);
            $('#medCat').val(d.Category);
            $('#medManuf').val(d.Manufacturer);
            $('#medBranchSel').val(d.BranchId);
            $('#medStock').val(d.StockQuantity);
            $('#medPrice').val(d.UnitPrice);
            $('#medMinAlert').val(d.MinStockAlert);
            $('#medExpiry').val(d.ExpiryDate);
            $('#medIsActive').prop('checked', d.IsActive);
            $('#medFormModal').modal('show');
        });
    }
}

/* ═══════════════════════════════════
   MEDICINE — VIEW DETAIL MODAL
═══════════════════════════════════ */
function openMedDetail(id) {
    $('#medDetailBody').html('<div class="ph-spinner"><i class="fa fa-spinner fa-spin"></i></div>');
    $('#medDetailModal').modal('show');
    $.getJSON('@Url.Action("GetMedicine","Pharmacy")', { id: id }, function(d) {
        if (!d.success) { $('#medDetailBody').html('<p style="color:#e74c3c;text-align:center;padding:30px">Error loading data</p>'); return; }
        var badges = '';
        if (d.IsLowStock)    badges += '<span class="bdg bdg-lowstock"><i class="fa fa-warning"></i> Low Stock</span> ';
        if (d.IsExpired)     badges += '<span class="bdg bdg-expired"><i class="fa fa-times-circle"></i> Expired</span> ';
        else if (d.IsExpiringSoon) badges += '<span class="bdg bdg-expiring"><i class="fa fa-clock-o"></i> Expiring Soon</span> ';
        badges += d.IsActive
            ? '<span class="bdg bdg-active"><i class="fa fa-circle" style="font-size:8px"></i> Active</span>'
            : '<span class="bdg bdg-inactive"><i class="fa fa-circle" style="font-size:8px"></i> Inactive</span>';

        var stockInfo = d.IsLowStock
            ? '<strong style="color:#e74c3c">' + d.StockQuantity + '</strong> <span style="color:#a0aab5;font-size:12px">(Min: ' + d.MinStockAlert + ')</span>'
            : '<strong>' + d.StockQuantity + '</strong> <span style="color:#a0aab5;font-size:12px">(Min: ' + d.MinStockAlert + ')</span>';

        var expInfo = d.ExpiryDateDisp;
        if (d.IsExpired) expInfo += ' <span class="bdg bdg-expired" style="margin-left:6px"><i class="fa fa-times-circle"></i> Expired</span>';
        else if (d.IsExpiringSoon) expInfo += ' <span class="bdg bdg-expiring" style="margin-left:6px"><i class="fa fa-clock-o"></i> Expiring Soon</span>';

        var html =
            '<div class="dt-hero">' +
                '<div class="dt-avatar" style="background:linear-gradient(135deg,#154360,#2980b9)"><i class="fa fa-medkit"></i></div>' +
                '<div>' +
                    '<h4>' + d.Name + '</h4>' +
                    '<div class="dt-badges"><span class="bdg-cat">' + (d.Category||'Uncategorized') + '</span> ' + badges + '</div>' +
                '</div>' +
            '</div>' +
            '<table class="dt-tbl">' +
                '<tr><th>Medicine Name</th><td><strong>' + d.Name + '</strong></td></tr>' +
                '<tr><th>Category</th><td><span class="bdg-cat">' + (d.Category||'-') + '</span></td></tr>' +
                '<tr><th>Manufacturer</th><td>' + (d.Manufacturer||'<span style="color:#bdc3c7">N/A</span>') + '</td></tr>' +
                '<tr><th>Branch</th><td>' + d.BranchName + '</td></tr>' +
                '<tr><th>Stock Quantity</th><td>' + stockInfo + '</td></tr>' +
                '<tr><th>Unit Price</th><td><strong style="font-size:15px;color:#1a2e44">Rs. ' + parseFloat(d.UnitPrice).toLocaleString() + '</strong></td></tr>' +
                '<tr><th>Expiry Date</th><td>' + expInfo + '</td></tr>' +
                '<tr><th>Status</th><td>' + (d.IsActive ? '<span class="bdg bdg-active">Active</span>' : '<span class="bdg bdg-inactive">Inactive</span>') + '</td></tr>' +
            '</table>';

        $('#medDetailBody').html(html);
        $('#medDetailEditBtn').off('click').on('click', function() {
            $('#medDetailModal').modal('hide');
            openMedForm(d.Id);
        });
    });
}

/* ═══════════════════════════════════
   MEDICINE — SAVE
═══════════════════════════════════ */
function saveMedicine() {
    var data = {
        Id:           parseInt($('#medId').val()),
        Name:         $.trim($('#medName').val()),
        Category:     $('#medCat').val(),
        Manufacturer: $.trim($('#medManuf').val()),
        BranchId:     parseInt($('#medBranchSel').val()) || 0,
        StockQuantity:parseInt($('#medStock').val()) || 0,
        UnitPrice:    parseFloat($('#medPrice').val()) || 0,
        MinStockAlert:parseInt($('#medMinAlert').val()) || 10,
        ExpiryDate:   $('#medExpiry').val(),
        IsActive:     $('#medIsActive').is(':checked')
    };
    if (!data.Name)       { showErr('medFormAlert','Medicine name is required!'); return; }
    if (!data.BranchId)   { showErr('medFormAlert','Please select a branch!'); return; }
    if (!data.ExpiryDate) { showErr('medFormAlert','Expiry date is required!'); return; }

    $.post('@Url.Action("SaveMedicine","Pharmacy")', data, function(r) {
        if (r.success) {
            $('#medFormModal').modal('hide');
            toast(r.message, 'success');
            loadMedicines();
        } else {
            showErr('medFormAlert', r.message);
        }
    });
}

/* ═══════════════════════════════════
   LAB — LOAD TABLE
═══════════════════════════════════ */
function loadLabs() {
    _labLoaded = true;
    $('#labBody').html('<tr><td colspan="10" class="empty-state"><i class="fa fa-spinner fa-spin"></i><p>Loading...</p></td></tr>');
    $.getJSON('@Url.Action("GetLabTests","Pharmacy")', {
        search: $('#labSearch').val(),
        status: $('#labStatusFilter').val()
    }, function(data) {
        if (!data.length) {
            $('#labBody').html('<tr><td colspan="10" class="empty-state"><i class="fa fa-flask"></i><p>No lab tests found.</p></td></tr>');
            return;
        }
        var html = '';
        $.each(data, function(i, l) {
            var stCell = l.Status === 'Completed'
                ? '<span class="bdg bdg-completed"><i class="fa fa-check-circle" style="font-size:10px"></i> Completed</span>'
                : '<span class="bdg bdg-pending"><i class="fa fa-clock-o" style="font-size:10px"></i> Pending</span>';
            var tn = l.TestName.replace(/\\/g,'\\\\').replace(/'/g,"\\'");
            html += '<tr>' +
                '<td class="t-muted">'+(i+1)+'</td>'+
                '<td class="t-name">'+l.TestName+'</td>'+
                '<td><span class="pat-pill">P-'+String(l.PatientId).padStart(4,'0')+'</span></td>'+
                '<td style="color:#5d6d7e">'+(l.DoctorId?'Dr-'+l.DoctorId:'<span style="color:#bdc3c7">N/A</span>')+'</td>'+
                '<td style="color:#5d6d7e">'+l.BranchName+'</td>'+
                '<td style="color:#5d6d7e">'+l.TestDate+'</td>'+
                '<td style="font-weight:700;color:#1a2e44">Rs. '+parseFloat(l.Charges).toLocaleString()+'</td>'+
                '<td>'+stCell+'</td>'+
                '<td style="color:#7f8c9a;font-size:12px;max-width:110px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+(l.Result||'—')+'</td>'+
                '<td style="text-align:center">'+
                    '<button class="act-btn ab-view"   title="View"   onclick="openLabDetail('+l.Id+')"><i class="fa fa-eye"></i></button>'+
                    '<button class="act-btn ab-edit"   title="Edit"   onclick="openLabForm('+l.Id+')"><i class="fa fa-pencil"></i></button>'+
                    '<button class="act-btn ab-delete" title="Delete" onclick="askDelete('+l.Id+',\'lab\',\''+tn+'\')"><i class="fa fa-trash"></i></button>'+
                '</td></tr>';
        });
        $('#labBody').html(html);
    });
}

function resetLab() {
    $('#labSearch').val('');
    $('#labStatusFilter').val('');
    loadLabs();
}

/* ═══════════════════════════════════
   LAB — ADD/EDIT MODAL
═══════════════════════════════════ */
function openLabForm(id) {
    $('#labFormAlert').hide();
    if (id === 0) {
        $('#labId').val('0');
        $('#labFormTitle').text('Add New Lab Test');
        $('#labSaveLbl').text('Save Lab Test');
        $('#labName,#labResult').val('');
        $('#labBranchSel,#labPatient,#labDoctor').val('0');
        $('#labCharges').val('0');
        $('#labDate').val(new Date().toISOString().split('T')[0]);
        $('#labStatus').val('Pending');
        $('#labFormModal').modal('show');
    } else {
        $.getJSON('@Url.Action("GetLabTest","Pharmacy")', { id: id }, function(d) {
            if (!d.success) { toast('Error loading test data','error'); return; }
            $('#labId').val(d.Id);
            $('#labFormTitle').text('Edit — ' + d.TestName);
            $('#labSaveLbl').text('Update Lab Test');
            $('#labName').val(d.TestName);
            $('#labBranchSel').val(d.BranchId);
            $('#labPatient').val(d.PatientId);
            $('#labDoctor').val(d.DoctorId);
            $('#labCharges').val(d.Charges);
            $('#labDate').val(d.TestDate);
            $('#labStatus').val(d.Status);
            $('#labResult').val(d.Result);
            $('#labFormModal').modal('show');
        });
    }
}

/* ═══════════════════════════════════
   LAB — VIEW DETAIL MODAL
═══════════════════════════════════ */
function openLabDetail(id) {
    $('#labDetailBody').html('<div class="ph-spinner"><i class="fa fa-spinner fa-spin"></i></div>');
    $('#labDetailModal').modal('show');
    $.getJSON('@Url.Action("GetLabTest","Pharmacy")', { id: id }, function(d) {
        if (!d.success) { $('#labDetailBody').html('<p style="color:#e74c3c;text-align:center;padding:30px">Error loading data</p>'); return; }
        var stBdg = d.Status === 'Completed'
            ? '<span class="bdg bdg-completed"><i class="fa fa-check-circle" style="font-size:10px"></i> Completed</span>'
            : '<span class="bdg bdg-pending"><i class="fa fa-clock-o" style="font-size:10px"></i> Pending</span>';

        var html =
            '<div class="dt-hero">' +
                '<div class="dt-avatar" style="background:linear-gradient(135deg,#0d6b55,#16a085)"><i class="fa fa-flask"></i></div>' +
                '<div>' +
                    '<h4>' + d.TestName + '</h4>' +
                    '<div class="dt-badges">' + stBdg + '</div>' +
                '</div>' +
            '</div>' +
            '<table class="dt-tbl">' +
                '<tr><th>Test Name</th><td><strong>' + d.TestName + '</strong></td></tr>' +
                '<tr><th>Patient</th><td>' + (d.PatientName ? '<span class="pat-pill">' + d.PatientName + '</span>' : '<span style="color:#bdc3c7">Not assigned</span>') + '</td></tr>' +
                '<tr><th>Referred By</th><td>' + (d.DoctorName || '<span style="color:#bdc3c7">Not assigned</span>') + '</td></tr>' +
                '<tr><th>Branch</th><td>' + d.BranchName + '</td></tr>' +
                '<tr><th>Test Date</th><td><strong>' + d.TestDateDisp + '</strong></td></tr>' +
                '<tr><th>Charges</th><td><strong style="font-size:15px;color:#1a2e44">Rs. ' + parseFloat(d.Charges).toLocaleString() + '</strong></td></tr>' +
                '<tr><th>Status</th><td>' + stBdg + '</td></tr>' +
                '<tr><th>Result / Remarks</th><td>' +
                    (d.Result
                        ? '<div class="dt-result">' + d.Result + '</div>'
                        : '<span style="color:#bdc3c7">Not entered yet</span>') +
                '</td></tr>' +
            '</table>';

        $('#labDetailBody').html(html);
        $('#labDetailEditBtn').off('click').on('click', function() {
            $('#labDetailModal').modal('hide');
            openLabForm(d.Id);
        });
    });
}

/* ═══════════════════════════════════
   LAB — SAVE
═══════════════════════════════════ */
function saveLabTest() {
    var data = {
        Id:       parseInt($('#labId').val()),
        TestName: $.trim($('#labName').val()),
        BranchId: parseInt($('#labBranchSel').val()) || 0,
        PatientId:parseInt($('#labPatient').val()) || 0,
        DoctorId: parseInt($('#labDoctor').val()) || 0,
        Charges:  parseFloat($('#labCharges').val()) || 0,
        TestDate: $('#labDate').val(),
        Status:   $('#labStatus').val(),
        Result:   $('#labResult').val()
    };
    if (!data.TestName) { showErr('labFormAlert','Test name is required!'); return; }

    $.post('@Url.Action("SaveLabTest","Pharmacy")', data, function(r) {
        if (r.success) {
            $('#labFormModal').modal('hide');
            toast(r.message, 'success');
            loadLabs();
        } else {
            showErr('labFormAlert', r.message);
        }
    });
}

/* ═══════════════════════════════════
   DELETE
═══════════════════════════════════ */
var _delId = 0, _delType = '';
function askDelete(id, type, name) {
    _delId = id; _delType = type;
    $('#deleteMsg').html('Delete <strong>"' + name + '"</strong>?');
    $('#deleteModal').modal('show');
}

$('#deleteConfirmBtn').click(function() {
    var url = _delType === 'medicine'
        ? '@Url.Action("DeleteMedicine","Pharmacy")'
        : '@Url.Action("DeleteLabTest","Pharmacy")';
    $.post(url, { id: _delId }, function(r) {
        $('#deleteModal').modal('hide');
        toast(r.message, r.success ? 'success' : 'error');
        if (r.success) {
            if (_delType === 'medicine') loadMedicines();
            else loadLabs();
        }
    });
});

/* ═══════════════════════════════════
   INIT
═══════════════════════════════════ */
function loadDropdowns() {
    $.getJSON('@Url.Action("GetPatients","Pharmacy")', function(d) {
        var o = '<option value="0">-- Select Patient --</option>';
        $.each(d, function(i, p) { o += '<option value="'+p.Id+'">'+p.Name+'</option>'; });
        $('#labPatient').html(o);
    });
    $.getJSON('@Url.Action("GetDoctors","Pharmacy")', function(d) {
        var o = '<option value="0">-- Select Doctor --</option>';
        $.each(d, function(i, p) { o += '<option value="'+p.Id+'">'+p.Name+'</option>'; });
        $('#labDoctor').html(o);
    });
}

$(document).ready(function() {
    loadMedicines();
    loadDropdowns();
});

$('#medSearch').on('keypress', function(e){ if(e.which===13) loadMedicines(); });
$('#labSearch').on('keypress', function(e){ if(e.which===13) loadLabs(); });
    </script>
}