@model HospitalMS.Models.Doctor
@{
    ViewBag.Title = "Doctor Details";
    ViewBag.ActiveMenu = "Doctor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header-box">
    <h3><i class="fa fa-eye"></i> Doctor Details</h3>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")">Dashboard</a></li>
        <li><a href="@Url.Action("Index")">Doctors</a></li>
        <li class="active">Details</li>
    </ol>
</div>

<div class="row">
    <!-- Profile Card -->
    <div class="col-md-3">
        <div class="card-box text-center">
            @if (!string.IsNullOrEmpty(Model.PhotoPath))
            {
                <img src="@Model.PhotoPath" style="width:120px;height:120px;border-radius:50%;object-fit:cover;border:4px solid #27ae60;margin-bottom:12px" />
            }
            else
            {
                <div style="width:120px;height:120px;border-radius:50%;background:linear-gradient(135deg,#16a085,#27ae60);display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:44px;font-weight:700;margin-bottom:12px">
                    @Model.FullName[0].ToString().ToUpper()
                </div>
            }

            <h4 style="color:#2c3e50;font-weight:700;margin-bottom:2px">Dr. @Model.FullName</h4>
            <p style="color:#27ae60;font-weight:600;font-size:13px;margin-bottom:2px">@Model.Specialization</p>
            <p style="color:#aaa;font-size:12px;margin-bottom:6px">@Model.Qualification</p>
            <p style="color:#7f8fa4;font-size:12px"><i class="fa fa-code-fork"></i> @Model.Branch?.Name</p>

            @if (Model.IsActive) { <span class="badge-active">Active</span> }
            else { <span class="badge-inactive">Inactive</span> }

            <hr />

            <!-- Appointment Stats -->
            <div class="row text-center">
                <div class="col-xs-6" style="border-right:1px solid #eee;padding:10px">
                    <div style="font-size:22px;font-weight:700;color:#2980b9">@ViewBag.TotalAppointments</div>
                    <div style="font-size:11px;color:#888">Total Apts</div>
                </div>
                <div class="col-xs-6" style="padding:10px">
                    <div style="font-size:22px;font-weight:700;color:#e74c3c">@ViewBag.TodayAppointments</div>
                    <div style="font-size:11px;color:#888">Today</div>
                </div>
            </div>
            <div class="row text-center" style="border-top:1px solid #eee">
                <div class="col-xs-6" style="border-right:1px solid #eee;padding:10px">
                    <div style="font-size:22px;font-weight:700;color:#27ae60">@ViewBag.CompletedAppointments</div>
                    <div style="font-size:11px;color:#888">Completed</div>
                </div>
                <div class="col-xs-6" style="padding:10px">
                    <div style="font-size:22px;font-weight:700;color:#f39c12">@ViewBag.PendingAppointments</div>
                    <div style="font-size:11px;color:#888">Pending</div>
                </div>
            </div>

            <hr />
            <a href="@Url.Action("Edit",new{id=Model.Id})" class="btn btn-warning btn-sm btn-block"><i class="fa fa-pencil"></i> Edit</a>
            <a href="@Url.Action("Index")" class="btn btn-default btn-sm btn-block" style="margin-top:5px"><i class="fa fa-arrow-left"></i> Back</a>
        </div>
    </div>

    <!-- Info Column -->
    <div class="col-md-9">
        <div class="card-box">
            <div class="card-title"><i class="fa fa-info-circle"></i> Professional Information</div>
            <div class="row">
                <div class="col-md-6">
                    <table class="table table-bordered">
                        <tr><th style="background:#f8f9fa;width:42%">Full Name</th><td><strong>Dr. @Model.FullName</strong></td></tr>
                        <tr><th style="background:#f8f9fa">Specialization</th><td><span class="label label-info">@Model.Specialization</span></td></tr>
                        <tr><th style="background:#f8f9fa">Qualification</th><td>@(string.IsNullOrEmpty(Model.Qualification)?"N/A":Model.Qualification)</td></tr>
                        <tr><th style="background:#f8f9fa">Consultation Fee</th><td><strong style="color:#27ae60;font-size:15px">Rs. @Model.ConsultationFee.ToString("N0")</strong></td></tr>
                    </table>
                </div>
                <div class="col-md-6">
                    <table class="table table-bordered">
                        <tr><th style="background:#f8f9fa;width:42%">Branch</th><td>@Model.Branch?.Name</td></tr>
                        <tr><th style="background:#f8f9fa">Department</th><td>@Model.Department?.Name</td></tr>
                        <tr><th style="background:#f8f9fa">Phone</th><td><i class="fa fa-phone text-success"></i> @Model.Phone</td></tr>
                        <tr><th style="background:#f8f9fa">Email</th><td><i class="fa fa-envelope text-primary"></i> @Model.Email</td></tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="card-box">
            <div class="card-title"><i class="fa fa-calendar-check-o"></i> Available Days</div>
            @if (!string.IsNullOrEmpty(Model.AvailableDays))
            {
                string[] days = Model.AvailableDays.Split(new[]{", "},StringSplitOptions.RemoveEmptyEntries);
                string[] allDays = {"Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"};
                <div class="row">
                    @foreach (var day in allDays)
                    {
                        bool available = days.Contains(day);
                        <div class="col-md-3" style="margin-bottom:8px">
                            <div style="border-radius:6px;padding:10px;text-align:center;font-size:13px;font-weight:600;background:@(available?"#d4edda":"#f8f9fa");color:@(available?"#155724":"#999");border:1px solid @(available?"#c3e6cb":"#ddd")">
                                @if (available) { <i class="fa fa-check-circle"></i> } else { <i class="fa fa-times-circle"></i> }
                                @day
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted"><i class="fa fa-info-circle"></i> No available days specified.</p>
            }
        </div>

        <div class="card-box">
            <div class="card-title"><i class="fa fa-bar-chart"></i> Appointment Summary</div>
            <div class="row text-center">
                <div class="col-md-3">
                    <div style="background:#eaf4fb;border-radius:8px;padding:16px">
                        <div style="font-size:28px;font-weight:700;color:#2980b9">@ViewBag.TotalAppointments</div>
                        <div style="font-size:12px;color:#666">Total Appointments</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div style="background:#fef3cd;border-radius:8px;padding:16px">
                        <div style="font-size:28px;font-weight:700;color:#856404">@ViewBag.TodayAppointments</div>
                        <div style="font-size:12px;color:#666">Today</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div style="background:#d4edda;border-radius:8px;padding:16px">
                        <div style="font-size:28px;font-weight:700;color:#155724">@ViewBag.CompletedAppointments</div>
                        <div style="font-size:12px;color:#666">Completed</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div style="background:#fff3cd;border-radius:8px;padding:16px">
                        <div style="font-size:28px;font-weight:700;color:#e67e22">@ViewBag.PendingAppointments</div>
                        <div style="font-size:12px;color:#666">Pending</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
