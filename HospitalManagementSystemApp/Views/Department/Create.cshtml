@model HospitalMS.Models.Department
@{
    ViewBag.Title = "Add Department";
    ViewBag.ActiveMenu = "Department";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="page-header-box">
    <h3><i class="fa fa-plus-circle"></i> Add New Department</h3>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")">Dashboard</a></li>
        <li><a href="@Url.Action("Index")">Department</a></li>
        <li class="active">Add</li>
    </ol>
</div>
<div class="row">
    <div class="col-md-7">
        <div class="card-box">
            <div class="card-title"><i class="fa fa-sitemap"></i> Department Information</div>
            @using (Html.BeginForm("Create", "Department", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label class="control-label">Branch <span class="text-danger">*</span></label>
                    @Html.DropDownList("BranchId", (SelectList)ViewBag.BranchId, "-- Select Branch --", new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.BranchId, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Name, new { @class = "control-label" }) <span class="text-danger">*</span>
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "e.g. Cardiology, Orthopedics, Emergency" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.DepartmentHead, new { @class = "control-label" })
                    @Html.TextBoxFor(m => m.DepartmentHead, new { @class = "form-control", placeholder = "Name of department head" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Description, new { @class = "control-label" })
                    @Html.TextAreaFor(m => m.Description, 3, 0, new { @class = "form-control", placeholder = "Brief description..." })
                </div>
                <div class="form-group">
                    <div class="checkbox">
                        <label>@Html.CheckBoxFor(m => m.IsActive) <strong>Is Active</strong></label>
                    </div>
                </div>
                <hr />
                <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save Department</button>
                <a href="@Url.Action("Index")" class="btn btn-default"><i class="fa fa-arrow-left"></i> Back</a>
            }
        </div>
    </div>
    <div class="col-md-5">
        <div class="card-box">
            <div class="card-title"><i class="fa fa-lightbulb-o"></i> Quick Guide</div>
            <ul class="list-unstyled" style="font-size:13px;line-height:2.2">
                <li><i class="fa fa-check text-success"></i> Select the correct branch first</li>
                <li><i class="fa fa-check text-success"></i> Department name must be unique per branch</li>
                <li><i class="fa fa-check text-success"></i> Department head is optional</li>
                <li><i class="fa fa-check text-success"></i> Only active departments appear in staff/doctor forms</li>
            </ul>
        </div>
    </div>
</div>
