<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Hospital Management System</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/3.4.1/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #f4f6f9; }

        /* ===== TOP NAVBAR ===== */
        .navbar-top {
            background: linear-gradient(135deg, #1a3c5e, #2980b9);
            border: none; border-radius: 0; margin-bottom: 0;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }
        .navbar-top .navbar-brand {
            color: #fff !important; font-size: 20px; font-weight: 700;
            padding: 12px 20px;
        }
        .navbar-top .navbar-brand img { height: 35px; margin-right: 8px; }
        .navbar-top .navbar-nav > li > a { color: #cfe2f3 !important; font-size: 13px; padding: 15px 14px; }
        .navbar-top .navbar-nav > li > a:hover { color: #fff !important; background: rgba(255,255,255,0.1); }
        .navbar-top .navbar-nav > li.active > a { background: rgba(255,255,255,0.15) !important; color: #fff !important; }

        /* ===== WRAPPER ===== */
        #wrapper { display: flex; min-height: calc(100vh - 52px); }

        /* ===== SIDEBAR ===== */
        #sidebar {
            width: 240px; min-width: 240px;
            background: #1e2a3a;
            padding-top: 10px;
            box-shadow: 2px 0 8px rgba(0,0,0,0.2);
            transition: all 0.3s;
        }
        #sidebar .sidebar-header {
            padding: 12px 20px; font-size: 11px; font-weight: 700;
            color: #7f8fa4; text-transform: uppercase; letter-spacing: 1px;
        }
        #sidebar ul { padding: 0; list-style: none; margin: 0; }
        #sidebar ul li a {
            display: block; padding: 10px 20px;
            color: #b8c7d9; font-size: 13px;
            text-decoration: none; transition: all 0.2s;
            border-left: 3px solid transparent;
        }
        #sidebar ul li a:hover {
            color: #fff; background: rgba(255,255,255,0.07);
            border-left-color: #2980b9;
        }
        #sidebar ul li.active > a {
            color: #fff; background: rgba(41,128,185,0.25);
            border-left-color: #2980b9;
        }
        #sidebar ul li a i { width: 20px; margin-right: 8px; font-size: 14px; }
        #sidebar .sidebar-divider {
            border-top: 1px solid #2c3e50; margin: 6px 0;
        }

        /* ===== CONTENT ===== */
        #content { flex: 1; padding: 20px; overflow-x: hidden; }

        /* ===== PAGE HEADER ===== */
        .page-header-box {
            background: #fff; padding: 14px 20px; margin-bottom: 20px;
            border-radius: 6px; box-shadow: 0 1px 4px rgba(0,0,0,0.08);
            display: flex; align-items: center; justify-content: space-between;
        }
        .page-header-box h3 { margin: 0; font-size: 20px; color: #2c3e50; font-weight: 600; }
        .page-header-box .breadcrumb { margin: 0; background: none; padding: 0; font-size: 12px; }

        /* ===== CARDS ===== */
        .card-box {
            background: #fff; border-radius: 8px;
            box-shadow: 0 1px 6px rgba(0,0,0,0.08);
            padding: 20px; margin-bottom: 20px;
        }
        .card-box .card-title {
            font-size: 16px; font-weight: 600; color: #2c3e50;
            border-bottom: 2px solid #eaf0f6; padding-bottom: 10px; margin-bottom: 16px;
        }

        /* ===== STAT CARDS ===== */
        .stat-card {
            border-radius: 8px; padding: 20px; color: #fff;
            margin-bottom: 20px; display: flex;
            align-items: center; justify-content: space-between;
            box-shadow: 0 3px 10px rgba(0,0,0,0.15);
        }
        .stat-card .stat-number { font-size: 32px; font-weight: 700; }
        .stat-card .stat-label { font-size: 13px; opacity: 0.9; }
        .stat-card .stat-icon { font-size: 42px; opacity: 0.4; }
        .stat-blue { background: linear-gradient(135deg, #2980b9, #3498db); }
        .stat-green { background: linear-gradient(135deg, #27ae60, #2ecc71); }
        .stat-orange { background: linear-gradient(135deg, #d35400, #e67e22); }
        .stat-red { background: linear-gradient(135deg, #c0392b, #e74c3c); }
        .stat-purple { background: linear-gradient(135deg, #8e44ad, #9b59b6); }
        .stat-teal { background: linear-gradient(135deg, #16a085, #1abc9c); }

        /* ===== TABLE ===== */
        .table-responsive { border-radius: 6px; overflow: hidden; }
        .table thead th {
            background: #1a3c5e; color: #fff; border: none;
            font-size: 13px; padding: 12px 14px;
        }
        .table tbody tr:hover { background: #eaf4fb; }
        .table tbody td { vertical-align: middle; font-size: 13px; padding: 10px 14px; }
        .table-striped tbody tr:nth-of-type(odd) { background: #f9fbfd; }

        /* ===== BUTTONS ===== */
        .btn-primary { background: #2980b9; border-color: #2471a3; }
        .btn-primary:hover { background: #1f6fa0; }
        .btn-sm { padding: 4px 10px; font-size: 12px; }

        /* ===== FORM ===== */
        .form-control { border-radius: 4px; border: 1px solid #d5dde3; font-size: 13px; }
        .form-control:focus { border-color: #2980b9; box-shadow: 0 0 0 2px rgba(41,128,185,0.15); }
        .control-label { font-weight: 600; font-size: 13px; color: #495057; }

        /* ===== ALERTS ===== */
        .alert { border-radius: 6px; font-size: 13px; }

        /* ===== BADGE STATUS ===== */
        .badge-active { background: #27ae60; color: #fff; padding: 3px 8px; border-radius: 10px; font-size: 11px; }
        .badge-inactive { background: #c0392b; color: #fff; padding: 3px 8px; border-radius: 10px; font-size: 11px; }
        .badge-pending { background: #f39c12; color: #fff; padding: 3px 8px; border-radius: 10px; font-size: 11px; }

        /* ===== FOOTER ===== */
        .footer-bar {
            background: #1e2a3a; color: #7f8fa4; text-align: center;
            padding: 10px; font-size: 12px;
        }
    </style>
</head>
<body>

    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-top navbar-static-top">
        <div class="container-fluid">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbarTop">
                    <span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span>
                </button>
                <a class="navbar-brand" href="@Url.Action("Index","Home")">
                    <i class="fa fa-hospital-o"></i> Hospital Management System
                </a>
            </div>
            <div class="collapse navbar-collapse" id="navbarTop">
                <ul class="nav navbar-nav navbar-right">
                    <li><a href="#"><i class="fa fa-bell"></i> Notifications</a></li>
                    <li class="dropdown">
                        <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                            <i class="fa fa-user-circle"></i> @(Session["UserName"] ?? "Admin") <b class="caret"></b>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-right">
                            <li><a href="#"><i class="fa fa-user"></i> Profile</a></li>
                            <li><a href="#"><i class="fa fa-cog"></i> Settings</a></li>
                            <li class="divider"></li>
                            <li><a href="@Url.Action("Logout","Account")"><i class="fa fa-sign-out"></i> Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- WRAPPER -->
    <div id="wrapper">

        <!-- SIDEBAR -->
        <nav id="sidebar">
            <div class="sidebar-header">Main Menu</div>
            <ul>
                <li class="@(ViewBag.ActiveMenu == "Dashboard" ? "active" : "")">
                    <a href="@Url.Action("Index","Home")"><i class="fa fa-tachometer"></i> Dashboard</a>
                </li>
            </ul>

            <div class="sidebar-header">Hospital Setup</div>
            <ul>
                <li class="@(ViewBag.ActiveMenu == "Hospital" ? "active" : "")">
                    <a href="@Url.Action("Index","Hospital")"><i class="fa fa-building"></i> Hospital (Company)</a>
                </li>
                <li class="@(ViewBag.ActiveMenu == "Branch" ? "active" : "")">
                    <a href="@Url.Action("Index","Branch")"><i class="fa fa-code-fork"></i> Branch Management</a>
                </li>
                <li class="@(ViewBag.ActiveMenu == "Department" ? "active" : "")">
                    <a href="@Url.Action("Index","Department")"><i class="fa fa-sitemap"></i> Department Management</a>
                </li>
                <li class="@(ViewBag.ActiveMenu == "Designation" ? "active" : "")">
                    <a href="@Url.Action("Index","Designation")"><i class="fa fa-id-badge"></i> Designation Management</a>
                </li>
                <li class="@(ViewBag.ActiveMenu == "Shift" ? "active" : "")">
                    <a href="@Url.Action("Index","Shift")"><i class="fa fa-clock-o"></i> Shift Management</a>
                </li>
            </ul>

            <div class="sidebar-divider"></div>
            <div class="sidebar-header">HR Management</div>
            <ul>
                <li class="@(ViewBag.ActiveMenu == "Staff" ? "active" : "")">
                    <a href="@Url.Action("Index","Staff")"><i class="fa fa-users"></i> Staff Management</a>
                </li>
                <li class="@(ViewBag.ActiveMenu == "Doctor" ? "active" : "")">
                    <a href="@Url.Action("Index","Doctor")"><i class="fa fa-user-md"></i> Doctor Management</a>
                </li>
                <li class="@(ViewBag.ActiveMenu == "Attendance" ? "active" : "")">
                    <a href="@Url.Action("Index","Attendance")"><i class="fa fa-calendar-check-o"></i> Attendance</a>
                </li>
                <li class="@(ViewBag.ActiveMenu == "Salary" ? "active" : "")">
                    <a href="@Url.Action("Index","Salary")"><i class="fa fa-money"></i> Salary / Payroll</a>
                </li>
            </ul>

            <div class="sidebar-divider"></div>
            <div class="sidebar-header">Patient & Clinical</div>
            <ul>
                <li class="@(ViewBag.ActiveMenu == "Patient" ? "active" : "")">
                    <a href="@Url.Action("Index","Patient")"><i class="fa fa-wheelchair"></i> Patient Management</a>
                </li>
                <li class="@(ViewBag.ActiveMenu == "Appointment" ? "active" : "")">
                    <a href="@Url.Action("Index","Appointment")"><i class="fa fa-calendar-plus-o"></i> Appointment</a>
                </li>
                <li class="@(ViewBag.ActiveMenu == "Billing" ? "active" : "")">
                    <a href="@Url.Action("Index","Billing")"><i class="fa fa-file-text-o"></i> Billing & Payment</a>
                </li>
                <li class="@(ViewBag.ActiveMenu == "Pharmacy" ? "active" : "")">
                    <a href="@Url.Action("Index","Pharmacy")"><i class="fa fa-medkit"></i> Pharmacy & Lab</a>
                </li>
            </ul>

            <div class="sidebar-divider"></div>
            <div class="sidebar-header">System</div>
            <ul>
                <li class="@(ViewBag.ActiveMenu == "Reports" ? "active" : "")">
                    <a href="@Url.Action("Index","Reports")"><i class="fa fa-bar-chart"></i> Reports</a>
                </li>
                <li class="@(ViewBag.ActiveMenu == "Users" ? "active" : "")">
                    <a href="@Url.Action("Index","Account")"><i class="fa fa-lock"></i> User Management</a>
                </li>
            </ul>
        </nav>

        <!-- CONTENT -->
        <div id="content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    <i class="fa fa-check-circle"></i> @TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    <i class="fa fa-times-circle"></i> @TempData["Error"]
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <div class="footer-bar">
        &copy; @DateTime.Now.Year Hospital Management System. All Rights Reserved.
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/3.4.1/js/bootstrap.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
