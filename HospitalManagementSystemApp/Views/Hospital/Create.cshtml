@model HospitalMS.Models.Hospital
@{
    ViewBag.Title = "Add Hospital";
    ViewBag.ActiveMenu = "Hospital";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header-box">
    <h3><i class="fa fa-plus-circle"></i> Add Hospital</h3>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")">Dashboard</a></li>
        <li><a href="@Url.Action("Index")">Hospital</a></li>
        <li class="active">Add</li>
    </ol>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <i class="fa fa-exclamation-circle"></i> <strong>Please fix the errors below:</strong>
        <ul style="margin:5px 0 0 15px">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@err.ErrorMessage</li>
            }
        </ul>
    </div>
}

@using (Html.BeginForm("Create", "Hospital", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="card-box">
        <div class="card-title"><i class="fa fa-building"></i> Basic Information</div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(m => m.Name, new { @class = "control-label" })
                    <span class="text-danger">*</span>
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter hospital name" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(m => m.RegistrationNo, new { @class = "control-label" })
                    @Html.TextBoxFor(m => m.RegistrationNo, new { @class = "form-control", placeholder = "e.g. REG-2024-001" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m => m.ContactNo, new { @class = "control-label" })
                    @Html.TextBoxFor(m => m.ContactNo, new { @class = "form-control", placeholder = "051-1234567" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m => m.Email, new { @class = "control-label" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "hospital@email.com" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m => m.Website, new { @class = "control-label" })
                    @Html.TextBoxFor(m => m.Website, new { @class = "form-control", placeholder = "www.hospital.com" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.LabelFor(m => m.Address, new { @class = "control-label" })
                    @Html.TextAreaFor(m => m.Address, 3, 0, new { @class = "form-control", placeholder = "Hospital full address" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    @Html.LabelFor(m => m.WorkingDays, new { @class = "control-label" })
                    @Html.TextBoxFor(m => m.WorkingDays, new { @class = "form-control", placeholder = "Mon - Sat" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="control-label">Hospital Logo <small class="text-muted">(JPG/PNG)</small></label>
                    <input type="file" name="logoFile" class="form-control" accept=".jpg,.jpeg,.png" onchange="previewLogo(this)" />
                    <div style="margin-top:8px;text-align:center">
                        <img id="logoPreview" src="#" style="display:none;height:60px;width:60px;border-radius:50%;object-fit:cover;border:2px solid #2980b9" />
                    </div>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="checkbox">
                <label>@Html.CheckBoxFor(m => m.IsActive) <strong>Is Active</strong></label>
            </div>
        </div>
    </div>

    <div class="card-box">
        <button type="submit" class="btn btn-primary btn-lg">
            <i class="fa fa-save"></i> Save Hospital
        </button>
        <a href="@Url.Action("Index")" class="btn btn-default btn-lg">
            <i class="fa fa-arrow-left"></i> Back to List
        </a>
    </div>
}

@section Scripts {
<script>
    function previewLogo(input) {
        if (input.files && input.files[0]) {
            var r = new FileReader();
            r.onload = function (e) {
                document.getElementById("logoPreview").src = e.target.result;
                document.getElementById("logoPreview").style.display = "inline-block";
            };
            r.readAsDataURL(input.files[0]);
        }
    }
</script>
}
