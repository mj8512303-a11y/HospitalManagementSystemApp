@model HospitalMS.Models.Billing
@{
    ViewBag.Title = "Edit Bill";
    ViewBag.ActiveMenu = "Billing";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="page-header-box">
    <h3><i class="fa fa-pencil"></i> Edit Bill — <span style="color:#2980b9">@Model.InvoiceNo</span></h3>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")">Dashboard</a></li>
        <li><a href="@Url.Action("Index")">Billing</a></li>
        <li class="active">Edit</li>
    </ol>
</div>

@using (Html.BeginForm("Edit", "Billing", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.InvoiceNo)
    @Html.HiddenFor(m => m.CreatedAt)

    <div class="row">
        <div class="col-md-8">
            <div class="card-box">
                <div class="card-title"><i class="fa fa-info-circle"></i> Bill Information — @Model.InvoiceNo</div>
                <div class="row">
                    <div class="col-md-5">
                        <div class="form-group">
                            <label class="control-label">Patient</label>
                            @Html.DropDownList("PatientId", (SelectList)ViewBag.PatientId, "-- Select --", new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="control-label">Branch</label>
                            @Html.DropDownList("BranchId", (SelectList)ViewBag.BranchId, "-- Select --", new { @class = "form-control" })
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label class="control-label">Date</label>
                            @Html.TextBoxFor(m => m.BillingDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            @Html.LabelFor(m => m.ConsultationFee, new { @class = "control-label" })
                            <div class="input-group">
                                <span class="input-group-addon">Rs.</span>
                                @Html.TextBoxFor(m => m.ConsultationFee, new { @class = "form-control calc-input", type = "number", min = "0" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            @Html.LabelFor(m => m.TestCharges, new { @class = "control-label" })
                            <div class="input-group">
                                <span class="input-group-addon">Rs.</span>
                                @Html.TextBoxFor(m => m.TestCharges, new { @class = "form-control calc-input", type = "number", min = "0" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            @Html.LabelFor(m => m.MedicineCharges, new { @class = "control-label" })
                            <div class="input-group">
                                <span class="input-group-addon">Rs.</span>
                                @Html.TextBoxFor(m => m.MedicineCharges, new { @class = "form-control calc-input", type = "number", min = "0" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            @Html.LabelFor(m => m.OtherCharges, new { @class = "control-label" })
                            <div class="input-group">
                                <span class="input-group-addon">Rs.</span>
                                @Html.TextBoxFor(m => m.OtherCharges, new { @class = "form-control calc-input", type = "number", min = "0" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            @Html.LabelFor(m => m.Discount, new { @class = "control-label" })
                            <div class="input-group">
                                <span class="input-group-addon">Rs.</span>
                                @Html.TextBoxFor(m => m.Discount, new { @class = "form-control calc-input", type = "number", min = "0" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            @Html.LabelFor(m => m.PaidAmount, new { @class = "control-label" })
                            <div class="input-group">
                                <span class="input-group-addon">Rs.</span>
                                @Html.TextBoxFor(m => m.PaidAmount, new { @class = "form-control calc-input", type = "number", min = "0" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="control-label">Payment Mode</label>
                            @Html.DropDownListFor(m => m.PaymentMode,
                                new SelectList(new[] { "Cash", "Card", "Online Transfer", "Cheque" }, Model.PaymentMode),
                                new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Notes, new { @class = "control-label" })
                    @Html.TextAreaFor(m => m.Notes, 2, 0, new { @class = "form-control" })
                </div>
            </div>
            <div class="card-box">
                <button type="submit" class="btn btn-primary btn-lg"><i class="fa fa-save"></i> Update Bill</button>
                <a href="@Url.Action("Index")" class="btn btn-default btn-lg"><i class="fa fa-arrow-left"></i> Back</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card-box">
                <div class="card-title"><i class="fa fa-calculator"></i> Live Calculation</div>
                <table class="table table-bordered" style="font-size:13px">
                    <tr><td>Consultation</td><td class="text-right" id="s-consult">0</td></tr>
                    <tr><td>Test Charges</td><td class="text-right" id="s-test">0</td></tr>
                    <tr><td>Medicine</td><td class="text-right" id="s-med">0</td></tr>
                    <tr><td>Other</td><td class="text-right" id="s-other">0</td></tr>
                    <tr><td class="text-danger">Discount</td><td class="text-right text-danger" id="s-discount">0</td></tr>
                    <tr style="background:#eaf4fb;font-weight:700"><td>Total</td><td class="text-right" id="s-total" style="color:#2980b9">Rs. 0</td></tr>
                    <tr><td class="text-success">Paid</td><td class="text-right text-success" id="s-paid">0</td></tr>
                    <tr style="font-weight:700"><td>Remaining</td><td class="text-right text-danger" id="s-remaining">Rs. 0</td></tr>
                </table>
                <div id="statusBadge" style="text-align:center;padding:10px;border-radius:6px;font-size:14px;font-weight:700"></div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
function fmt(n) { return "Rs. " + parseInt(n < 0 ? 0 : n).toLocaleString(); }
function recalc() {
    var c = parseFloat(document.getElementById('ConsultationFee').value)||0;
    var t = parseFloat(document.getElementById('TestCharges').value)||0;
    var m = parseFloat(document.getElementById('MedicineCharges').value)||0;
    var o = parseFloat(document.getElementById('OtherCharges').value)||0;
    var d = parseFloat(document.getElementById('Discount').value)||0;
    var p = parseFloat(document.getElementById('PaidAmount').value)||0;
    var total = c+t+m+o-d, rem = total - p;
    document.getElementById('s-consult').textContent  = fmt(c);
    document.getElementById('s-test').textContent     = fmt(t);
    document.getElementById('s-med').textContent      = fmt(m);
    document.getElementById('s-other').textContent    = fmt(o);
    document.getElementById('s-discount').textContent = fmt(d);
    document.getElementById('s-total').textContent    = fmt(total);
    document.getElementById('s-paid').textContent     = fmt(p);
    document.getElementById('s-remaining').textContent = fmt(rem);
    var badge = document.getElementById('statusBadge');
    if (p<=0){badge.style.background='#fde8e8';badge.style.color='#c0392b';badge.innerHTML='<i class="fa fa-times-circle"></i> PENDING';}
    else if (p>=total&&total>0){badge.style.background='#d4edda';badge.style.color='#155724';badge.innerHTML='<i class="fa fa-check-circle"></i> PAID';}
    else{badge.style.background='#fef3cd';badge.style.color='#856404';badge.innerHTML='<i class="fa fa-adjust"></i> PARTIAL';}
}
document.querySelectorAll('.calc-input').forEach(function(el){el.addEventListener('input',recalc);});
window.onload = recalc;
    </script>
}
