@model HospitalMS.Models.Salary
@{
    ViewBag.Title = "Edit Salary";
    ViewBag.ActiveMenu = "Salary";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="page-header-box">
    <h3><i class="fa fa-pencil"></i> Edit Salary — @Model.EmployeeName</h3>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")">Dashboard</a></li>
        <li><a href="@Url.Action("Index")">Salary</a></li>
        <li class="active">Edit</li>
    </ol>
</div>

@using (Html.BeginForm("Edit","Salary",FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m=>m.Id)
    @Html.HiddenFor(m=>m.EmployeeId)
    @Html.HiddenFor(m=>m.EmployeeType)
    @Html.HiddenFor(m=>m.Month)
    @Html.HiddenFor(m=>m.Year)
    @Html.HiddenFor(m=>m.PresentDays)
    @Html.HiddenFor(m=>m.AbsentDays)
    @Html.HiddenFor(m=>m.CreatedAt)
    @Html.HiddenFor(m=>m.PaymentDate)

    <div class="row">
        <div class="col-md-7">
            <div class="card-box">
                <div class="card-title">
                    <i class="fa fa-user"></i> @Model.EmployeeName
                    <span class="label label-@(Model.EmployeeType=="Staff"?"primary":"success")" style="margin-left:8px">@Model.EmployeeType</span>
                    <span style="margin-left:8px;color:#7f8fa4;font-size:13px">@(new DateTime(Model.Year,Model.Month,1).ToString("MMMM yyyy"))</span>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m=>m.BasicSalary,new{@class="control-label"})
                            <div class="input-group">
                                <span class="input-group-addon">Rs.</span>
                                @Html.TextBoxFor(m=>m.BasicSalary,new{@class="form-control salary-input",type="number",step="100"})
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m=>m.Allowances,new{@class="control-label"})
                            <div class="input-group">
                                <span class="input-group-addon">Rs.</span>
                                @Html.TextBoxFor(m=>m.Allowances,new{@class="form-control salary-input",type="number",step="100"})
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m=>m.Bonus,new{@class="control-label"})
                            <div class="input-group">
                                <span class="input-group-addon">Rs.</span>
                                @Html.TextBoxFor(m=>m.Bonus,new{@class="form-control salary-input",type="number",step="100"})
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m=>m.OvertimeAmount,new{@class="control-label"})
                            <div class="input-group">
                                <span class="input-group-addon">Rs.</span>
                                @Html.TextBoxFor(m=>m.OvertimeAmount,new{@class="form-control salary-input",type="number",step="100"})
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.LabelFor(m=>m.Deductions,new{@class="control-label"})
                            <div class="input-group">
                                <span class="input-group-addon">Rs.</span>
                                @Html.TextBoxFor(m=>m.Deductions,new{@class="form-control salary-input",type="number",step="100"})
                            </div>
                            <small class="text-muted">Auto-calculated from @Model.AbsentDays absent days, can be adjusted</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="control-label">Net Salary (Auto-calculated)</label>
                            <div class="input-group">
                                <span class="input-group-addon">Rs.</span>
                                <input type="text" id="netSalaryDisplay" class="form-control" readonly
                                       style="font-weight:700;font-size:16px;color:#2980b9;background:#eaf4fb"
                                       value="@Model.NetSalary.ToString("N0")" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(m=>m.Remarks,new{@class="control-label"})
                    @Html.TextAreaFor(m=>m.Remarks,2,0,new{@class="form-control",placeholder="Any notes about this salary..."})
                </div>
                <div class="form-group">
                    <div class="checkbox">
                        <label>@Html.CheckBoxFor(m=>m.IsPaid) <strong>Mark as Paid</strong></label>
                    </div>
                </div>
            </div>
            <div class="card-box">
                <button type="submit" class="btn btn-primary btn-lg"><i class="fa fa-save"></i> Update Salary</button>
                <a href="@Url.Action("Index",new{month=Model.Month,year=Model.Year})" class="btn btn-default btn-lg"><i class="fa fa-arrow-left"></i> Back</a>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card-box">
                <div class="card-title"><i class="fa fa-calendar-check-o"></i> Attendance Summary</div>
                <div class="row text-center">
                    <div class="col-xs-6">
                        <div style="background:#d4edda;border-radius:8px;padding:16px">
                            <div style="font-size:28px;font-weight:700;color:#155724">@Model.PresentDays</div>
                            <div style="font-size:12px;color:#666">Present Days</div>
                        </div>
                    </div>
                    <div class="col-xs-6">
                        <div style="background:#fde8e8;border-radius:8px;padding:16px">
                            <div style="font-size:28px;font-weight:700;color:#c0392b">@Model.AbsentDays</div>
                            <div style="font-size:12px;color:#666">Absent Days</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-box">
                <div class="card-title"><i class="fa fa-calculator"></i> Live Calculation</div>
                <table class="table table-bordered" style="font-size:13px">
                    <tr><td>Basic Salary</td><td class="text-right" id="calc-basic">@Model.BasicSalary.ToString("N0")</td></tr>
                    <tr><td>+ Allowances</td><td class="text-right text-success" id="calc-allow">@Model.Allowances.ToString("N0")</td></tr>
                    <tr><td>+ Bonus</td><td class="text-right text-success" id="calc-bonus">@Model.Bonus.ToString("N0")</td></tr>
                    <tr><td>+ Overtime</td><td class="text-right text-success" id="calc-ot">@Model.OvertimeAmount.ToString("N0")</td></tr>
                    <tr><td>− Deductions</td><td class="text-right text-danger" id="calc-ded">@Model.Deductions.ToString("N0")</td></tr>
                    <tr style="background:#eaf4fb;font-weight:700"><td>Net Salary</td><td class="text-right" id="calc-net" style="color:#2980b9">@Model.NetSalary.ToString("N0")</td></tr>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
function recalc() {
    var basic = parseFloat($('#BasicSalary').val()) || 0;
    var allow = parseFloat($('#Allowances').val()) || 0;
    var bonus = parseFloat($('#Bonus').val()) || 0;
    var ot    = parseFloat($('#OvertimeAmount').val()) || 0;
    var ded   = parseFloat($('#Deductions').val()) || 0;
    var net   = basic + allow + bonus + ot - ded;

    $('#calc-basic').text(basic.toLocaleString());
    $('#calc-allow').text(allow.toLocaleString());
    $('#calc-bonus').text(bonus.toLocaleString());
    $('#calc-ot').text(ot.toLocaleString());
    $('#calc-ded').text(ded.toLocaleString());
    $('#calc-net').text(net.toLocaleString());
    $('#netSalaryDisplay').val(net.toLocaleString());
}
$('.salary-input').on('input', recalc);
</script>
}
