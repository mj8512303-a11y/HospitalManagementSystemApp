@model HospitalMS.Models.Designation
@{
    ViewBag.Title = "Edit Designation";
    ViewBag.ActiveMenu = "Designation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header-box">
    <h3><i class="fa fa-pencil"></i> Edit Designation</h3>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")">Dashboard</a></li>
        <li><a href="@Url.Action("Index")">Designation</a></li>
        <li class="active">Edit</li>
    </ol>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="card-box">
            <div class="card-title"><i class="fa fa-id-badge"></i> Update Designation</div>
            @using (Html.BeginForm("Edit", "Designation", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.CreatedAt)

                <div class="form-group">
                    @Html.LabelFor(m => m.Name, new { @class = "control-label" })
                    <span class="text-danger">*</span>
                    @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.BasicSalary, new { @class = "control-label" })
                    <div class="input-group">
                        <span class="input-group-addon">Rs.</span>
                        @Html.TextBoxFor(m => m.BasicSalary, new { @class = "form-control", type = "number", min = "0", step = "100" })
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Description, new { @class = "control-label" })
                    @Html.TextAreaFor(m => m.Description, 4, 0, new { @class = "form-control" })
                </div>
                <div class="form-group">
                    <div class="checkbox">
                        <label>@Html.CheckBoxFor(m => m.IsActive) <strong>Is Active</strong></label>
                    </div>
                </div>
                <hr />
                <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Update</button>
                <a href="@Url.Action("Index")" class="btn btn-default"><i class="fa fa-arrow-left"></i> Back</a>
            }
        </div>
    </div>
    <div class="col-md-5">
        <div class="card-box">
            <div class="card-title"><i class="fa fa-bar-chart"></i> Designation Stats</div>
            <p><i class="fa fa-users text-primary"></i> <strong>Staff assigned:</strong> @ViewBag.StaffCount</p>
            <p><i class="fa fa-calendar text-muted"></i> <strong>Created:</strong> @Model.CreatedAt.ToString("dd MMM yyyy")</p>
            <hr />
            <p class="text-warning" style="font-size:12px">
                <i class="fa fa-exclamation-triangle"></i>
                Changing basic salary here does not automatically update existing staff salaries.
            </p>
        </div>
    </div>
</div>
