@model HospitalMS.Models.Patient
@{
    ViewBag.Title = "Edit Patient";
    ViewBag.ActiveMenu = "Patient";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header-box">
    <h3><i class="fa fa-pencil"></i> Edit Patient</h3>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")">Dashboard</a></li>
        <li><a href="@Url.Action("Index")">Patients</a></li>
        <li class="active">Edit — P-@Model.Id.ToString("D4")</li>
    </ol>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-circle"></i> <strong>Fix errors below:</strong>
        <ul style="margin:6px 0 0 18px">
            @foreach (var e in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            { <li>@e.ErrorMessage</li> }
        </ul>
    </div>
}

@using (Html.BeginForm("Edit","Patient",FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m=>m.Id)
    @Html.HiddenFor(m=>m.CreatedAt)
    @Html.HiddenFor(m=>m.RegistrationDate)

    <div class="card-box">
        <div class="card-title"><i class="fa fa-user"></i> Personal Information
            <span style="font-size:13px;font-weight:400;margin-left:10px;color:#7f8fa4">
                Patient ID: <strong style="color:#2980b9">P-@Model.Id.ToString("D4")</strong>
            </span>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m=>m.FullName,new{@class="control-label"}) <span class="text-danger">*</span>
                    @Html.TextBoxFor(m=>m.FullName,new{@class="form-control"})
                    @Html.ValidationMessageFor(m=>m.FullName,"",new{@class="text-danger small"})
                </div>
            </div>
            <div class="col-md-2">
                <div class="form-group">
                    @Html.LabelFor(m=>m.Age,new{@class="control-label"}) <span class="text-danger">*</span>
                    @Html.TextBoxFor(m=>m.Age,new{@class="form-control",type="number",min="0",max="150"})
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="control-label">Gender <span class="text-danger">*</span></label>
                    @Html.DropDownListFor(m=>m.Gender,
                        new SelectList(new[]{"Male","Female","Other"},Model.Gender),
                        "-- Select --",new{@class="form-control"})
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="control-label">Blood Group</label>
                    @Html.DropDownListFor(m=>m.BloodGroup,
                        new SelectList(new[]{"A+","A-","B+","B-","AB+","AB-","O+","O-"},Model.BloodGroup),
                        "-- Select --",new{@class="form-control"})
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m=>m.Phone,new{@class="control-label"}) <span class="text-danger">*</span>
                    @Html.TextBoxFor(m=>m.Phone,new{@class="form-control"})
                    @Html.ValidationMessageFor(m=>m.Phone,"",new{@class="text-danger small"})
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m=>m.Email,new{@class="control-label"})
                    @Html.TextBoxFor(m=>m.Email,new{@class="form-control"})
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m=>m.EmergencyContact,new{@class="control-label"})
                    @Html.TextBoxFor(m=>m.EmergencyContact,new{@class="form-control"})
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-8">
                <div class="form-group">
                    @Html.LabelFor(m=>m.Address,new{@class="control-label"})
                    @Html.TextAreaFor(m=>m.Address,2,0,new{@class="form-control"})
                </div>
            </div>
        </div>
    </div>

    <div class="card-box">
        <div class="card-title"><i class="fa fa-heartbeat"></i> Medical Information</div>
        <div class="row">
            <div class="col-md-8">
                <div class="form-group">
                    @Html.LabelFor(m=>m.MedicalHistory,new{@class="control-label"})
                    @Html.TextAreaFor(m=>m.MedicalHistory,3,0,new{@class="form-control",placeholder="Previous diseases, allergies, surgeries..."})
                </div>
            </div>
        </div>
    </div>

    <div class="card-box">
        <div class="card-title"><i class="fa fa-hospital-o"></i> Registration Details</div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label class="control-label">Branch</label>
                    @Html.DropDownList("BranchId",(SelectList)ViewBag.BranchId,"-- Select --",new{@class="form-control"})
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="control-label">Patient Type</label>
                    @Html.DropDownListFor(m=>m.PatientType,
                        new SelectList(new[]{"OPD","IPD"},Model.PatientType),
                        new{@class="form-control",id="patientType",onchange="toggleIPD(this.value)"})
                </div>
            </div>
        </div>
        <div id="ipdSection" style="display:@(Model.PatientType=="IPD"?"block":"none")">
            <hr style="border-color:#ffeeba" />
            <div style="background:#fffbea;border:1px solid #ffeeba;border-radius:6px;padding:10px;margin-bottom:10px">
                <i class="fa fa-bed text-warning"></i> <strong>IPD Details</strong>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        @Html.LabelFor(m=>m.AdmissionDate,new{@class="control-label"})
                        @Html.TextBoxFor(m=>m.AdmissionDate,"{0:yyyy-MM-dd}",new{@class="form-control",type="date"})
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        @Html.LabelFor(m=>m.DischargeDate,new{@class="control-label"})
                        @Html.TextBoxFor(m=>m.DischargeDate,"{0:yyyy-MM-dd}",new{@class="form-control",type="date"})
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card-box">
        <button type="submit" class="btn btn-primary btn-lg"><i class="fa fa-save"></i> Update Patient</button>
        <a href="@Url.Action("Index")" class="btn btn-default btn-lg"><i class="fa fa-arrow-left"></i> Back</a>
    </div>
}
@section Scripts {
<script>
    function toggleIPD(v) {
        document.getElementById("ipdSection").style.display = v === "IPD" ? "block" : "none";
    }
</script>
}
