<!-- Toast -->
<div id="db-toast"></div>


@section Scripts {
    <script>
/* ── Toast ── */
function toast(msg, type) {
    var el = document.getElementById('db-toast');
    el.style.background = type === 'success' ? '#27ae60' : '#e74c3c';
    el.innerHTML = '<i class="fa fa-' + (type==='success'?'check-circle':'times-circle') + '"></i> ' + msg;
    el.style.display = 'flex';
    setTimeout(function(){ el.style.display='none'; }, 3800);
}
function showErr(id, msg) {
    var el = document.getElementById(id);
    el.innerHTML = '<i class="fa fa-exclamation-circle"></i> ' + msg;
    el.style.display = 'flex';
    setTimeout(function(){ el.style.display='none'; }, 4500);
}

/* ── Load Patients & Doctors for dropdowns ── */
$(document).ready(function() {
    // Set today as default appointment date
    $('#appt-date').val(new Date().toISOString().split('T')[0]);

    // Load patients dropdown
    $.getJSON('@Url.Action("GetPatients","Appointment")', function(d) {
        if (!d) return;
        var o = '<option value="0">-- Select Patient --</option>';
        $.each(d, function(i, p) { o += '<option value="'+p.Id+'">'+p.Name+'</option>'; });
        $('#appt-patient').html(o);
    }).fail(function(){
        // silently fail if endpoint doesn't exist
    });

    // Load doctors dropdown
    $.getJSON('@Url.Action("GetDoctors","Appointment")', function(d) {
        if (!d) return;
        var o = '<option value="0">-- Select Doctor --</option>';
        $.each(d, function(i, p) { o += '<option value="'+p.Id+'">'+p.Name+'</option>'; });
        $('#appt-doctor').html(o);
    }).fail(function(){});
});

/* ── Save Patient (quick register) ── */
function savePatient() {
    var name  = $.trim($('#pat-name').val());
    var phone = $.trim($('#pat-phone').val());
    if (!name)  { showErr('pat-alert','Full name is required!'); return; }
    if (!phone) { showErr('pat-alert','Phone number is required!'); return; }

    var data = {
        FullName:    name,
        Phone:       phone,
        Age:         parseInt($('#pat-age').val()) || 0,
        Gender:      $('#pat-gender').val(),
        PatientType: $('#pat-type').val(),
        Address:     $.trim($('#pat-addr').val()),
        CNIC:        $.trim($('#pat-cnic').val()),
        RegistrationDate: new Date().toISOString().split('T')[0]
    };

    $.post('@Url.Action("QuickCreate","Patient")', data, function(r) {
        if (r && r.success) {
            $('#modal-patient').modal('hide');
            toast('Patient "' + name + '" registered! ID: P-' + String(r.id).padStart(4,'0'), 'success');
            setTimeout(function(){ location.reload(); }, 2200);
        } else {
            showErr('pat-alert', (r && r.message) ? r.message : 'Error saving patient. Please try again.');
        }
    }).fail(function(){
        showErr('pat-alert','Server error. Please use the Full Form.');
    });
}

/* ── Save Appointment (quick book) ── */
function saveAppointment() {
    var patId  = parseInt($('#appt-patient').val()) || 0;
    var docId  = parseInt($('#appt-doctor').val())  || 0;
    var date   = $('#appt-date').val();
    if (!patId) { showErr('appt-alert','Please select a patient!'); return; }
    if (!docId) { showErr('appt-alert','Please select a doctor!'); return; }
    if (!date)  { showErr('appt-alert','Please select a date!'); return; }

    var data = {
        PatientId:       patId,
        DoctorId:        docId,
        AppointmentDate: date,
        TimeSlot:        $('#appt-time').val(),
        Status:          $('#appt-status').val(),
        Remarks:         $.trim($('#appt-notes').val())
    };

    $.post('@Url.Action("QuickCreate","Appointment")', data, function(r) {
        if (r && r.success) {
            $('#modal-appt').modal('hide');
            toast('Appointment booked successfully!', 'success');
            setTimeout(function(){ location.reload(); }, 2200);
        } else {
            showErr('appt-alert', (r && r.message) ? r.message : 'Error booking appointment.');
        }
    }).fail(function(){
        showErr('appt-alert','Server error. Please use the Full Form.');
    });
}
    </script>
}