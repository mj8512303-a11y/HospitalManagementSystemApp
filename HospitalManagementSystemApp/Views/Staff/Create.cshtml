@model HospitalMS.Models.Staff
@{
    ViewBag.Title = "Add Staff Member";
    ViewBag.ActiveMenu = "Staff";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="page-header-box">
    <h3><i class="fa fa-user-plus"></i> Add Staff Member</h3>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")">Dashboard</a></li>
        <li><a href="@Url.Action("Index")">Staff</a></li>
        <li class="active">Add</li>
    </ol>
</div>

@using (Html.BeginForm("Create","Staff",FormMethod.Post,new{enctype="multipart/form-data"})) {
    @Html.AntiForgeryToken()

    <div class="card-box">
        <div class="card-title"><i class="fa fa-user"></i> Personal Information</div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m=>m.FullName,new{@class="control-label"}) <span class="text-danger">*</span>
                    @Html.TextBoxFor(m=>m.FullName,new{@class="form-control",placeholder="Full name"})
                    @Html.ValidationMessageFor(m=>m.FullName,"",new{@class="text-danger"})
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m=>m.CNIC,new{@class="control-label"}) <span class="text-danger">*</span>
                    @Html.TextBoxFor(m=>m.CNIC,new{@class="form-control",placeholder="35201-1234567-1",maxlength="15"})
                    @Html.ValidationMessageFor(m=>m.CNIC,"",new{@class="text-danger"})
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label class="control-label">Gender</label>
                    @Html.DropDownListFor(m=>m.Gender,new SelectList(new[]{"Male","Female","Other"}),"-- Select --",new{@class="form-control"})
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m=>m.DateOfBirth,new{@class="control-label"})
                    @Html.TextBoxFor(m=>m.DateOfBirth,"{0:yyyy-MM-dd}",new{@class="form-control",type="date"})
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m=>m.Phone,new{@class="control-label"})
                    @Html.TextBoxFor(m=>m.Phone,new{@class="form-control",placeholder="03001234567"})
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    @Html.LabelFor(m=>m.Email,new{@class="control-label"})
                    @Html.TextBoxFor(m=>m.Email,new{@class="form-control",placeholder="staff@email.com"})
                    @Html.ValidationMessageFor(m=>m.Email,"",new{@class="text-danger"})
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-8">
                <div class="form-group">
                    @Html.LabelFor(m=>m.Address,new{@class="control-label"})
                    @Html.TextAreaFor(m=>m.Address,2,0,new{@class="form-control",placeholder="Full residential address"})
                </div>
            </div>
        </div>
    </div>

    <div class="card-box">
        <div class="card-title"><i class="fa fa-briefcase"></i> Job Information</div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    <label class="control-label">Branch <span class="text-danger">*</span></label>
                    @Html.DropDownList("BranchId",(SelectList)ViewBag.BranchId,"-- Select Branch --",new{@class="form-control"})
                    @Html.ValidationMessageFor(m=>m.BranchId,"",new{@class="text-danger"})
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="control-label">Department <span class="text-danger">*</span></label>
                    @Html.DropDownList("DepartmentId",(SelectList)ViewBag.DepartmentId,"-- Select Department --",new{@class="form-control"})
                    @Html.ValidationMessageFor(m=>m.DepartmentId,"",new{@class="text-danger"})
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="control-label">Designation <span class="text-danger">*</span></label>
                    @Html.DropDownList("DesignationId",(SelectList)ViewBag.DesignationId,"-- Select Designation --",new{@class="form-control"})
                    @Html.ValidationMessageFor(m=>m.DesignationId,"",new{@class="text-danger"})
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="control-label">Shift <span class="text-danger">*</span></label>
                    @Html.DropDownList("ShiftId",(SelectList)ViewBag.ShiftId,"-- Select Shift --",new{@class="form-control"})
                    @Html.ValidationMessageFor(m=>m.ShiftId,"",new{@class="text-danger"})
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-3">
                <div class="form-group">
                    @Html.LabelFor(m=>m.JoinDate,new{@class="control-label"}) <span class="text-danger">*</span>
                    @Html.TextBoxFor(m=>m.JoinDate,"{0:yyyy-MM-dd}",new{@class="form-control",type="date"})
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="control-label">Status</label>
                    @Html.DropDownListFor(m=>m.Status,new SelectList(new[]{"Active","OnLeave","Terminated"},"Active"),new{@class="form-control"})
                </div>
            </div>
        </div>
    </div>

    <div class="card-box">
        <div class="card-title"><i class="fa fa-paperclip"></i> Photo & Documents</div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <label class="control-label">Profile Photo <small class="text-muted">(JPG / PNG only)</small></label>
                    <input type="file" name="photoFile" class="form-control" accept=".jpg,.jpeg,.png" onchange="previewImg(this)" />
                    <div style="margin-top:10px;text-align:center">
                        <img id="imgPreview" src="#" alt="" style="display:none;width:90px;height:90px;border-radius:50%;object-fit:cover;border:3px solid #2980b9" />
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label class="control-label">Document <small class="text-muted">(CNIC / Degree / Contract)</small></label>
                    <input type="file" name="docFile" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" />
                    <small class="text-muted"><i class="fa fa-info-circle"></i> Supported: PDF, JPG, PNG, DOC, DOCX</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card-box">
        <button type="submit" class="btn btn-primary btn-lg">
            <i class="fa fa-save"></i> Save Staff Member
        </button>
        <a href="@Url.Action("Index")" class="btn btn-default btn-lg">
            <i class="fa fa-arrow-left"></i> Back to List
        </a>
    </div>
}

@section Scripts {
<script>
    function previewImg(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById("imgPreview").src = e.target.result;
                document.getElementById("imgPreview").style.display = "block";
            };
            reader.readAsDataURL(input.files[0]);
        }
    }
</script>
}
