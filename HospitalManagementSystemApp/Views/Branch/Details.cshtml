@model HospitalMS.Models.Branch
@{
    ViewBag.Title = "Branch Details";
    ViewBag.ActiveMenu = "Branch";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-header-box">
    <h3><i class="fa fa-eye"></i> Branch Details</h3>
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index","Home")">Dashboard</a></li>
        <li><a href="@Url.Action("Index")">Branch</a></li>
        <li class="active">Details</li>
    </ol>
</div>

<div class="row">
    <!-- Left Card -->
    <div class="col-md-4">
        <div class="card-box text-center">
            <div style="background:linear-gradient(135deg,#1a3c5e,#2980b9);border-radius:50%;width:80px;height:80px;display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px">
                <i class="fa fa-code-fork" style="font-size:36px;color:#fff"></i>
            </div>
            <h4 style="color:#2c3e50;font-weight:700">@Model.Name</h4>
            <p class="text-muted">Code: <strong>@Model.Code</strong></p>
            @if (Model.IsActive)
            {<span class="badge-active">Active</span> }
            else
            { <span class="badge-inactive">Inactive</span>}

            <hr />

            <!-- Stats -->
            <div class="row text-center">
                <div class="col-xs-6" style="padding:10px;border-right:1px solid #eee">
                    <div style="font-size:22px;font-weight:700;color:#2980b9">@ViewBag.TotalDepartments</div>
                    <div style="font-size:11px;color:#888">Departments</div>
                </div>
                <div class="col-xs-6" style="padding:10px">
                    <div style="font-size:22px;font-weight:700;color:#27ae60">@ViewBag.TotalDoctors</div>
                    <div style="font-size:11px;color:#888">Doctors</div>
                </div>
            </div>
            <div class="row text-center" style="border-top:1px solid #eee">
                <div class="col-xs-6" style="padding:10px;border-right:1px solid #eee">
                    <div style="font-size:22px;font-weight:700;color:#8e44ad">@ViewBag.TotalStaff</div>
                    <div style="font-size:11px;color:#888">Staff</div>
                </div>
                <div class="col-xs-6" style="padding:10px">
                    <div style="font-size:22px;font-weight:700;color:#e67e22">@ViewBag.TotalPatients</div>
                    <div style="font-size:11px;color:#888">Patients</div>
                </div>
            </div>

            <hr />
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="btn btn-warning btn-sm">
                <i class="fa fa-pencil"></i> Edit
            </a>
            <a href="@Url.Action("Index")" class="btn btn-default btn-sm">
                <i class="fa fa-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <!-- Right Card -->
    <div class="col-md-8">
        <div class="card-box">
            <div class="card-title"><i class="fa fa-info-circle"></i> Branch Information</div>
            <table class="table table-bordered">
                <tr>
                    <th style="width:35%;background:#f8f9fa">Hospital</th>
                    <td><i class="fa fa-hospital-o text-primary"></i> @Model.Hospital?.Name</td>
                </tr>
                <tr>
                    <th style="background:#f8f9fa">Branch Name</th>
                    <td><strong>@Model.Name</strong></td>
                </tr>
                <tr>
                    <th style="background:#f8f9fa">Branch Code</th>
                    <td><span class="label label-primary">@Model.Code</span></td>
                </tr>
                <tr>
                    <th style="background:#f8f9fa">Location</th>
                    <td><i class="fa fa-map-marker text-danger"></i> @Model.Location</td>
                </tr>
                <tr>
                    <th style="background:#f8f9fa">Contact No</th>
                    <td><i class="fa fa-phone text-success"></i> @Model.ContactNo</td>
                </tr>
                <tr>
                    <th style="background:#f8f9fa">Email</th>
                    <td><i class="fa fa-envelope text-primary"></i> @Model.Email</td>
                </tr>
                <tr>
                    <th style="background:#f8f9fa">Working Hours</th>
                    <td><i class="fa fa-clock-o text-warning"></i> @Model.WorkingHours</td>
                </tr>
                <tr>
                    <th style="background:#f8f9fa">Status</th>
                    <td>
                        @if (Model.IsActive)
                        {<span class="badge-active">Active</span> }
                        else
                        { <span class="badge-inactive">Inactive</span>}
                    </td>
                </tr>
                <tr>
                    <th style="background:#f8f9fa">Created At</th>
                    <td>@Model.CreatedAt.ToString("dd MMM yyyy")</td>
                </tr>
            </table>
        </div>

        @if (Model.Departments != null && Model.Departments.Any())
        {
            <div class="card-box">
                <div class="card-title"><i class="fa fa-sitemap"></i> Departments in this Branch</div>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr><th>#</th><th>Department</th><th>Head</th><th>Status</th></tr>
                        </thead>
                        <tbody>
                            @{ int i = 1; }
                            @foreach (var d in Model.Departments)
                            {
                                <tr>
                                    <td>@(i++)</td>
                                    <td>@d.Name</td>
                                    <td>@d.DepartmentHead</td>
                                    <td>
                                        @if (d.IsActive)
                                        {<span class="badge-active">Active</span> }
                                        else
                                        { <span class="badge-inactive">Inactive</span>}
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
