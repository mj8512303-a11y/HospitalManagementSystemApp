<div class="card-box">
    <div class="card-title">
        <i class="fa fa-list"></i> All Appointments
        <a href="@Url.Action("Create")" class="btn btn-primary btn-sm pull-right">
            <i class="fa fa-calendar-plus-o"></i> Book Appointment
        </a>
    </div>

    @using (Html.BeginForm("Index","Appointment",FormMethod.Get)) {
        <div class="row" style="margin-bottom:15px">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-addon"><i class="fa fa-search"></i></span>
                    <input type="text" name="search" value="@ViewBag.SearchVal" class="form-control" placeholder="Patient / Doctor name..." />
                </div>
            </div>
            <div class="col-md-2">
                @Html.DropDownList("doctorId",(SelectList)ViewBag.DoctorList,"-- All Doctors --",new{@class="form-control"})
            </div>
            <div class="col-md-2">
                <input type="date" name="date" value="@ViewBag.DateVal" class="form-control" />
            </div>
            <div class="col-md-2">
                <select name="status" class="form-control">
                    <option value="">-- All Status --</option>
                    <option value="Pending"   @(ViewBag.StatusVal=="Pending"?"selected":"")>Pending</option>
                    <option value="Approved"  @(ViewBag.StatusVal=="Approved"?"selected":"")>Approved</option>
                    <option value="Completed" @(ViewBag.StatusVal=="Completed"?"selected":"")>Completed</option>
                    <option value="Cancelled" @(ViewBag.StatusVal=="Cancelled"?"selected":"")>Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Search</button>
                <a href="@Url.Action("Index")" class="btn btn-default"><i class="fa fa-refresh"></i> Reset</a>
                <a href="@Url.Action("Index",new{date=DateTime.Today.ToString("yyyy-MM-dd")})" class="btn btn-info btn-sm">Today</a>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Apt. ID</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Branch</th>
                    <th>Date</th>
                    <th>Time Slot</th>
                    <th>Status</th>
                    <th>Booked By</th>
                    <th style="width:190px">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int sr = 1; }
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@(sr++)</td>
                        <td>
                            <span style="background:#eaf4fb;color:#2980b9;padding:3px 8px;border-radius:10px;font-weight:700;font-size:12px">
                                APT-@a.Id.ToString("D4")
                            </span>
                        </td>
                        <td>
                            <i class="fa fa-wheelchair text-primary"></i>
                            @(a.Patient != null ? a.Patient.FullName : "N/A")
                        </td>
                        <td>
                            <i class="fa fa-user-md text-success"></i>
                            Dr. @(a.Doctor != null ? a.Doctor.FullName : "N/A")
                        </td>
                        <td>@(a.Branch != null ? a.Branch.Name : "N/A")</td>
                        <td>
                            @if (a.AppointmentDate.Date == DateTime.Today)
                            { <span class="label label-warning"><i class="fa fa-star"></i> Today</span> }
                            else
                            { @a.AppointmentDate.ToString("dd MMM yyyy") }
                        </td>
                        <td><i class="fa fa-clock-o text-info"></i> @a.TimeSlot</td>
                        <td>
                            @if (a.Status == "Pending")    { <span class="badge-pending">Pending</span> }
                            else if (a.Status == "Approved")  { <span class="label label-info" style="padding:4px 8px">Approved</span> }
                            else if (a.Status == "Completed") { <span class="badge-active">Completed</span> }
                            else                               { <span class="badge-inactive">Cancelled</span> }
                        </td>
                        <td><small>@a.BookedBy</small></td>
                        <td>
                            <a href="@Url.Action("Details",new{id=a.Id})" class="btn btn-info btn-sm" title="Details"><i class="fa fa-eye"></i></a>
                            <a href="@Url.Action("Edit",new{id=a.Id})" class="btn btn-warning btn-sm" title="Edit"><i class="fa fa-pencil"></i></a>
                            @if (a.Status == "Pending")
                            {
                                <a href="@Url.Action("UpdateStatus",new{id=a.Id,status="Approved"})" class="btn btn-success btn-sm" title="Approve"><i class="fa fa-check"></i></a>
                            }
                            @if (a.Status == "Approved")
                            {
                                <a href="@Url.Action("UpdateStatus",new{id=a.Id,status="Completed"})" class="btn btn-primary btn-sm" title="Complete"><i class="fa fa-check-circle"></i></a>
                            }
                            @if (a.Status != "Completed" && a.Status != "Cancelled")
                            {
                                <a href="@Url.Action("UpdateStatus",new{id=a.Id,status="Cancelled"})" class="btn btn-danger btn-sm" title="Cancel" onclick="return confirm('Cancel this appointment?')"><i class="fa fa-ban"></i></a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
