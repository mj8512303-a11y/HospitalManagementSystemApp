                }
            </tbody>
        </table>
    </div>
</div>-->
@*@model IEnumerable<HospitalMS.Models.Appointment>*@
@{
    ViewBag.Title = "Appointment Management";
    ViewBag.ActiveMenu = "Appointment";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ?? Page Header ?? */
    .apt-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
        flex-wrap: wrap;
        gap: 12px;
    }

    .apt-header-left {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .apt-page-icon {
        width: 44px;
        height: 44px;
        border-radius: 11px;
        background: #2563eb;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .apt-page-icon i {
            color: #fff;
            font-size: 18px;
        }

    .apt-header-left h3 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -.3px;
    }

    .apt-breadcrumb {
        font-size: 11.5px;
        color: #94a3b8;
        margin-top: 2px;
    }

        .apt-breadcrumb a {
            color: #2563eb;
            text-decoration: none;
        }

    .btn-book {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #2563eb;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 9px 18px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background .15s;
    }

        .btn-book:hover {
            background: #1d4ed8;
            color: #fff;
            text-decoration: none;
        }

    /* ?? Stat Cards ?? */
    .apt-stats {
        display: grid;
        grid-template-columns: repeat(6,1fr);
        gap: 12px;
        margin-bottom: 22px;
    }

    .apt-stat {
        background: #fff;
        border: 1px solid #e8ecf0;
        border-radius: 12px;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 11px;
        transition: box-shadow .15s;
        border-top: 3px solid transparent;
    }

        .apt-stat:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,.07);
        }

    .apt-stat-ic {
        width: 38px;
        height: 38px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .apt-stat-val {
        font-size: 22px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1;
        letter-spacing: -1px;
    }

    .apt-stat-lbl {
        font-size: 10px;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-top: 2px;
    }

    .s-total {
        border-top-color: #2563eb;
    }

        .s-total .apt-stat-ic {
            background: #eff6ff;
            color: #2563eb;
        }

    .s-today {
        border-top-color: #0891b2;
    }

        .s-today .apt-stat-ic {
            background: #ecfeff;
            color: #0891b2;
        }

    .s-pending {
        border-top-color: #d97706;
    }

        .s-pending .apt-stat-ic {
            background: #fffbeb;
            color: #d97706;
        }

    .s-approved {
        border-top-color: #7c3aed;
    }

        .s-approved.apt-stat-ic {
            background: #f5f3ff;
            color: #7c3aed;
        }

        .s-approved .apt-stat-ic {
            background: #f5f3ff;
            color: #7c3aed;
        }

    .s-done {
        border-top-color: #16a34a;
    }

        .s-done .apt-stat-ic {
            background: #f0fdf4;
            color: #16a34a;
        }

    .s-cancel {
        border-top-color: #ef4444;
    }

        .s-cancel .apt-stat-ic {
            background: #fef2f2;
            color: #ef4444;
        }

    /* ?? Main Card ?? */
    .apt-card {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #e8ecf0;
        overflow: hidden;
    }

    /* ?? Card Header ?? */
    .apt-card-hd {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px 20px;
        border-bottom: 1px solid #f1f5f9;
        flex-wrap: wrap;
        gap: 10px;
    }

    .apt-card-hd-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .apt-card-hd-left i {
            color: #2563eb;
        }

        .apt-card-hd-left span {
            font-size: 14px;
            font-weight: 700;
            color: #0f172a;
        }

    /* ?? Filter Bar ?? */
    .apt-filters {
        padding: 14px 20px;
        background: #fafbfd;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

        .apt-filters .input-wrap {
            position: relative;
            flex: 1;
            min-width: 180px;
            max-width: 240px;
        }

            .apt-filters .input-wrap i {
                position: absolute;
                left: 11px;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
                font-size: 13px;
                pointer-events: none;
            }

            .apt-filters .input-wrap input,
            .apt-filters .input-wrap select {
                width: 100%;
                height: 36px;
                padding-left: 32px;
                border: 1px solid #e2e8f0;
                border-radius: 8px;
                font-size: 12.5px;
                color: #1e293b;
                background: #fff;
                font-family: inherit;
                outline: none;
                transition: border .14s;
            }

                .apt-filters .input-wrap input:focus,
                .apt-filters .input-wrap select:focus {
                    border-color: #93c5fd;
                    box-shadow: 0 0 0 3px rgba(37,99,235,.1);
                }

        .apt-filters .plain-input {
            height: 36px;
            padding: 0 12px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            font-size: 12.5px;
            color: #1e293b;
            background: #fff;
            font-family: inherit;
            outline: none;
            transition: border .14s;
        }

            .apt-filters .plain-input:focus {
                border-color: #93c5fd;
                box-shadow: 0 0 0 3px rgba(37,99,235,.1);
            }

    .apt-filter-btns {
        display: flex;
        gap: 7px;
        margin-left: auto;
    }

    .f-btn {
        height: 36px;
        padding: 0 14px;
        border-radius: 8px;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: none;
        text-decoration: none;
        transition: .14s;
    }

        .f-btn.primary {
            background: #2563eb;
            color: #fff;
        }

            .f-btn.primary:hover {
                background: #1d4ed8;
                color: #fff;
            }

        .f-btn.default {
            background: #fff;
            color: #475569;
            border: 1px solid #e2e8f0;
        }

            .f-btn.default:hover {
                background: #f8fafc;
                color: #1e293b;
            }

        .f-btn.info {
            background: #ecfeff;
            color: #0891b2;
            border: 1px solid #cffafe;
        }

            .f-btn.info:hover {
                background: #cffafe;
            }

    /* ?? Table ?? */
    .apt-table {
        width: 100%;
        border-collapse: collapse;
    }

        .apt-table thead th {
            background: #fafafa;
            color: #94a3b8;
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .7px;
            padding: 11px 16px;
            text-align: left;
            border-bottom: 1px solid #f1f5f9;
            white-space: nowrap;
        }

        .apt-table tbody tr {
            border-bottom: 1px solid #f8f9fb;
            transition: background .12s;
        }

            .apt-table tbody tr:hover {
                background: #fafbfd;
            }

        .apt-table tbody td {
            padding: 12px 16px;
            color: #475569;
            vertical-align: middle;
        }

    /* Apt ID chip */
    .apt-id-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #eff6ff;
        color: #2563eb;
        border: 1px solid #dbeafe;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: .3px;
        white-space: nowrap;
    }

    /* Person cell */
    .person-cell {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .person-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .pa-patient {
        background: #eff6ff;
        color: #2563eb;
    }

    .pa-doctor {
        background: #f0fdf4;
        color: #16a34a;
    }

    .person-name {
        font-weight: 600;
        color: #1e293b;
        font-size: 13px;
    }

    .person-sub {
        font-size: 11px;
        color: #94a3b8;
        margin-top: 1px;
    }

    /* Date cell */
    .today-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #fffbeb;
        color: #d97706;
        border: 1px solid #fde68a;
        padding: 3px 9px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .date-txt {
        font-weight: 600;
        color: #1e293b;
        font-size: 13px;
    }

    .time-txt {
        font-size: 11px;
        color: #94a3b8;
        margin-top: 1px;
    }

    /* Status badges */
    .s-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 11px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 700;
    }

        .s-badge i {
            font-size: 7px;
        }

    .sb-pending {
        background: #fffbeb;
        color: #d97706;
        border: 1px solid #fde68a;
    }

    .sb-approved {
        background: #f5f3ff;
        color: #7c3aed;
        border: 1px solid #e9d5ff;
    }

    .sb-completed {
        background: #f0fdf4;
        color: #16a34a;
        border: 1px solid #bbf7d0;
    }

    .sb-cancelled {
        background: #fef2f2;
        color: #ef4444;
        border: 1px solid #fecaca;
    }

    /* Branch chip */
    .branch-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        padding: 3px 8px;
        border-radius: 6px;
        font-size: 11.5px;
        font-weight: 500;
        color: #64748b;
    }

    /* Action buttons */
    .apt-acts {
        display: flex;
        gap: 5px;
        flex-wrap: nowrap;
    }

    .a-btn {
        width: 30px;
        height: 30px;
        border-radius: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12.5px;
        border: none;
        cursor: pointer;
        text-decoration: none;
        transition: all .14s;
        flex-shrink: 0;
    }

        .a-btn:hover {
            text-decoration: none;
        }

    .ab-view {
        background: #eff6ff;
        color: #2563eb;
    }

        .ab-view:hover {
            background: #2563eb;
            color: #fff;
        }

    .ab-edit {
        background: #fffbeb;
        color: #d97706;
    }

        .ab-edit:hover {
            background: #d97706;
            color: #fff;
        }

    .ab-approve {
        background: #f0fdf4;
        color: #16a34a;
    }

        .ab-approve:hover {
            background: #16a34a;
            color: #fff;
        }

    .ab-complete {
        background: #f5f3ff;
        color: #7c3aed;
    }

        .ab-complete:hover {
            background: #7c3aed;
            color: #fff;
        }

    .ab-cancel {
        background: #fef2f2;
        color: #ef4444;
    }

        .ab-cancel:hover {
            background: #ef4444;
            color: #fff;
        }

    /* Row number */
    .row-num {
        color: #cbd5e1;
        font-weight: 700;
        font-size: 12px;
    }

    /* Empty state */
    .apt-empty {
        text-align: center;
        padding: 60px 20px;
    }

    .apt-empty-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: #eff6ff;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .apt-empty-icon i {
            font-size: 30px;
            color: #bfdbfe;
        }

    .apt-empty h5 {
        font-size: 16px;
        font-weight: 700;
        color: #64748b;
        margin: 0 0 6px;
    }

    .apt-empty p {
        font-size: 13.5px;
        color: #94a3b8;
    }

    @@media(max-width:900px) {
        .apt-stats {
            grid-template-columns: repeat(3,1fr);
        }
    }

    @@media(max-width:600px) {
        .apt-stats {
            grid-template-columns: repeat(2,1fr);
        }
    }
</style>

<!-- ?? Page Header ?? -->
<div class="apt-header">
    <div class="apt-header-left">
        <div class="apt-page-icon"><i class="fa fa-calendar-plus-o"></i></div>
        <div>
            <h3>Appointment Management</h3>
            <div class="apt-breadcrumb">
                <a href="@Url.Action("Index","Home")"><i class="fa fa-home"></i> Dashboard</a>
                &rsaquo; Appointments
            </div>
        </div>
    </div>
    <a href="@Url.Action("Create")" class="btn-book">
        <i class="fa fa-calendar-plus-o"></i> Book Appointment
    </a>
</div>

<!-- ?? Stats Row ?? -->
<div class="apt-stats">
    <div class="apt-stat s-total">
        <div class="apt-stat-ic"><i class="fa fa-calendar"></i></div>
        <div><div class="apt-stat-val">@ViewBag.Total</div><div class="apt-stat-lbl">Total</div></div>
    </div>
    <div class="apt-stat s-today">
        <div class="apt-stat-ic"><i class="fa fa-calendar-check-o"></i></div>
        <div><div class="apt-stat-val">@ViewBag.Today</div><div class="apt-stat-lbl">Today</div></div>
    </div>
    <div class="apt-stat s-pending">
        <div class="apt-stat-ic"><i class="fa fa-clock-o"></i></div>
        <div><div class="apt-stat-val">@ViewBag.Pending</div><div class="apt-stat-lbl">Pending</div></div>
    </div>
    <div class="apt-stat s-approved">
        <div class="apt-stat-ic"><i class="fa fa-check"></i></div>
        <div><div class="apt-stat-val">@ViewBag.Approved</div><div class="apt-stat-lbl">Approved</div></div>
    </div>
    <div class="apt-stat s-done">
        <div class="apt-stat-ic"><i class="fa fa-check-circle"></i></div>
        <div><div class="apt-stat-val">@ViewBag.Completed</div><div class="apt-stat-lbl">Completed</div></div>
    </div>
    <div class="apt-stat s-cancel">
        <div class="apt-stat-ic"><i class="fa fa-times-circle"></i></div>
        <div><div class="apt-stat-val">@ViewBag.Cancelled</div><div class="apt-stat-lbl">Cancelled</div></div>
    </div>
</div>

<!-- ?? Main Card ?? -->
<div class="apt-card">

    <!-- Card Header -->
    <div class="apt-card-hd">
        <div class="apt-card-hd-left">
            <i class="fa fa-list-ul"></i>
            <span>All Appointments</span>
        </div>
    </div>

    <!-- Filter Bar -->
    @using (Html.BeginForm("Index", "Appointment", FormMethod.Get))
    {
        <div class="apt-filters">
            <div class="input-wrap">
                <i class="fa fa-search"></i>
                <input type="text" name="search" value="@ViewBag.SearchVal" placeholder="Patient / Doctor name..." />
            </div>

            <div class="input-wrap">
                <i class="fa fa-user-md"></i>
                @Html.DropDownList("doctorId", (SelectList)ViewBag.DoctorList, "-- All Doctors --", new { @class = "" })
            </div>

            <div class="input-wrap">
                <i class="fa fa-calendar"></i>
                <input type="date" name="date" value="@ViewBag.DateVal" class="" />
            </div>

            <div class="input-wrap">
                <i class="fa fa-filter"></i>
                <select name="status">
                    <option value="">-- All Status --</option>
                    <option value="Pending" @(ViewBag.StatusVal == "Pending" ? "selected" : "")>Pending</option>
                    <option value="Approved" @(ViewBag.StatusVal == "Approved" ? "selected" : "")>Approved</option>
                    <option value="Completed" @(ViewBag.StatusVal == "Completed" ? "selected" : "")>Completed</option>
                    <option value="Cancelled" @(ViewBag.StatusVal == "Cancelled" ? "selected" : "")>Cancelled</option>
                </select>
            </div>

            <div class="apt-filter-btns">
                <button type="submit" class="f-btn primary">
                    <i class="fa fa-search"></i> Search
                </button>
                <a href="@Url.Action("Index")" class="f-btn default">
                    <i class="fa fa-refresh"></i> Reset
                </a>
                <a href="@Url.Action("Index", new { date = DateTime.Today.ToString("yyyy-MM-dd") })" class="f-btn info">
                    <i class="fa fa-star"></i> Today
                </a>
            </div>
        </div>
    }

    <!-- Table -->
    <div style="overflow-x:auto">
        <table class="apt-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Apt. ID</th>
                    <th>Patient</th>
                    <th>Doctor</th>
                    <th>Branch</th>
                    <th>Date</th>
                    <th>Time Slot</th>
                    <th>Status</th>
                    <th>Booked By</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ int s = 1; }
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="row-num">@string.Format("{0:D2}", sr++)</td>

                        <td>
                            <span class="apt-id-chip">
                                <i class="fa fa-hashtag" style="font-size:10px"></i>
                                APT-@a.Id.ToString("D4")
                            </span>
                        </td>

                        <td>
                            <div class="person-cell">
                                <div class="person-avatar pa-patient">
                                    @(a.Patient != null ? a.Patient.FullName.Substring(0,1).ToUpper() : "?")
                                </div>
                                <div>
                                    <div class="person-name">
                                        @(a.Patient != null ? a.Patient.FullName : "N/A")
                                    </div>
                                    <div class="person-sub">Patient</div>
                                </div>
                            </div>
                        </td>

                        <td>
                            <div class="person-cell">
                                <div class="person-avatar pa-doctor">
                                    @(a.Doctor != null ? a.Doctor.FullName.Substring(0,1).ToUpper() : "?")
                                </div>
                                <div>
                                    <div class="person-name">
                                        Dr. @(a.Doctor != null ? a.Doctor.FullName : "N/A")
                                    </div>
                                    <div class="person-sub">Doctor</div>
                                </div>
                            </div>
                        </td>

                        <td>
                            <span class="branch-chip">
                                <i class="fa fa-code-fork" style="font-size:11px"></i>
                                @(a.Branch != null ? a.Branch.Name : "N/A")
                            </span>
                        </td>

                        <td>
                            @if (a.AppointmentDate.Date == DateTime.Today)
                            {
                                <span class="today-chip">
                                    <i class="fa fa-star" style="font-size:9px"></i> Today
                                </span>
                            }
                            else
                            {
                                <div class="date-txt">@a.AppointmentDate.ToString("dd MMM yyyy")</div>
                                <div class="time-txt">@a.AppointmentDate.ToString("ddd")</div>
                            }
                        </td>

                        <td>
                            <div class="date-txt"><i class="fa fa-clock-o" style="color:#94a3b8;margin-right:4px"></i>@a.TimeSlot</div>
                        </td>

                        <td>
                            @if (a.Status == "Pending")
                            {
                                <span class="s-badge sb-pending"><i class="fa fa-circle"></i> Pending</span>
                            }
                            else if (a.Status == "Approved")
                            {
                                <span class="s-badge sb-approved"><i class="fa fa-circle"></i> Approved</span>
                            }
                            else if (a.Status == "Completed")
                            {
                                <span class="s-badge sb-completed"><i class="fa fa-circle"></i> Completed</span>
                            }
                            else
                            {
                                <span class="s-badge sb-cancelled"><i class="fa fa-circle"></i> Cancelled</span>
                            }
                        </td>

                        <td>
                            <div class="person-sub" style="font-size:12px;color:#64748b;font-weight:500">
                                <i class="fa fa-user-o" style="color:#cbd5e1;margin-right:3px"></i>
                                @a.BookedBy
                            </div>
                        </td>

                        <td>
                            <div class="apt-acts">
                                <a href="@Url.Action("Details", new { id = a.Id })"
                                   class="a-btn ab-view" title="View Details">
                                    <i class="fa fa-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", new { id = a.Id })"
                                   class="a-btn ab-edit" title="Edit">
                                    <i class="fa fa-pencil"></i>
                                </a>
                                @if (a.Status == "Pending")
                                {
                                    <a href="@Url.Action("UpdateStatus", new { id = a.Id, status = "Approved" })"
                                       class="a-btn ab-approve" title="Approve">
                                        <i class="fa fa-check"></i>
                                    </a>
                                }
                                @if (a.Status == "Approved")
                                {
                                    <a href="@Url.Action("UpdateStatus", new { id = a.Id, status = "Completed" })"
                                       class="a-btn ab-complete" title="Mark Completed">
                                        <i class="fa fa-check-circle"></i>
                                    </a>
                                }
                                @if (a.Status != "Completed" && a.Status != "Cancelled")
                                {
                                    <a href="@Url.Action("UpdateStatus", new { id = a.Id, status = "Cancelled" })"
                                       class="a-btn ab-cancel" title="Cancel"
                                       onclick="return confirm('Cancel appointment APT-@a.Id.ToString("D4")?')">
                                        <i class="fa fa-ban"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10">
                            <div class="apt-empty">
                                <div class="apt-empty-icon">
                                    <i class="fa fa-calendar-times-o"></i>
                                </div>
                                <h5>No Appointments Found</h5>
                                <p>No records match your filters. Try resetting or book a new appointment.</p>
                                <a href="@Url.Action("Create")" class="btn-book" style="margin-top:10px;display:inline-flex">
                                    <i class="fa fa-calendar-plus-o"></i> Book Appointment
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
